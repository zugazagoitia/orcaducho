#!/usr/bin/env python3
"""orcaducho: launcher, spawner, GitHub-issue sync and hooks for the orcaducho harness.

Every mechanical step lives here so agents spend tokens only on decisions.
Stdlib only; works on macOS and Linux.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

PLUGIN = "orcaducho"
ROLES = ("coordinator", "lead", "worker")
DEFAULT_MODEL = {"coordinator": "opus", "lead": "sonnet", "worker": "haiku"}
REVIEW_MODEL = {"med": "haiku", "high": "sonnet"}
MAX_GATE_FAILURES = 2  # first failure: worker fixes; second: report failed so the coordinator escalates
DIFF_LIMIT = 60_000
# Auto mode: a classifier approves routine actions, so unattended sessions do not stall on prompts.
DEFAULT_CLAUDE_ARGS = ("--permission-mode", "auto")
SKIP_PERMISSIONS_ARGS = ("--dangerously-skip-permissions",)


# ---------------------------------------------------------------- helpers

def die(msg: str, code: int = 1) -> None:
    print(f"orcaducho: {msg}", file=sys.stderr)
    sys.exit(code)


def orca_exe() -> str:
    """Resolve the Orca CLI exactly as the orca-cli skill prescribes."""
    if os.environ.get("ORCA_CLI_COMMAND"):
        return os.environ["ORCA_CLI_COMMAND"]
    if os.environ.get("ORCA_DEV_REPO_ROOT"):
        return "orca-dev"
    if sys.platform.startswith("linux") and not os.environ.get("ORCA_TERMINAL_HANDLE"):
        return "orca-ide"  # bare `orca` is the GNOME screen reader outside Orca terminals
    return "orca"


def run(cmd: list[str], cwd: str | None = None, check: bool = True, timeout: int | None = None) -> subprocess.CompletedProcess:
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    if check and p.returncode != 0:
        die(f"{shlex.join(cmd)} failed ({p.returncode}): {(p.stderr or p.stdout).strip()[-800:]}")
    return p


def orca(*args: str, check: bool = True) -> dict:
    p = run([orca_exe(), *args, "--json"], check=False)
    try:
        data = json.loads(p.stdout)
    except json.JSONDecodeError:
        data = {"ok": False, "raw": (p.stdout + p.stderr).strip()[-800:]}
    if check and (p.returncode != 0 or not data.get("ok", False)):
        die(f"orca {' '.join(args[:2])} failed: {json.dumps(data.get('error') or data)[:800]}")
    return data


def find(obj, pred):
    """Depth-first search for the first (key, value) pair matching pred."""
    if isinstance(obj, dict):
        for k, v in obj.items():
            if pred(k, v):
                return v
            r = find(v, pred)
            if r is not None:
                return r
    elif isinstance(obj, list):
        for v in obj:
            r = find(v, pred)
            if r is not None:
                return r
    return None


def git(*args: str, cwd: str | None = None, check: bool = True) -> str:
    return run(["git", *args], cwd=cwd, check=check).stdout.strip()


def toplevel(cwd: str | None = None) -> Path:
    return Path(git("rev-parse", "--show-toplevel", cwd=cwd, check=False) or cwd or os.getcwd()).resolve()


def config(cwd: str | None = None) -> dict:
    cfg = {"check": "", "base": "", "issues": True, "lang": "en", "autonomous": True, "advisor": "",
           "claudeArgs": list(DEFAULT_CLAUDE_ARGS)}
    try:
        f = toplevel(cwd) / ".orcaducho.json"
        if f.exists():
            cfg.update(json.loads(f.read_text()))
    except SystemExit:
        pass
    return cfg


def label(role: str, title: str) -> str:
    text = f"{PLUGIN}:{role} · {title}"
    return text if len(text) <= 60 else text[:59] + "…"


def slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "task"


def plugin_dir_args() -> list[str]:
    """ORCADUCHO_PLUGIN_DIR loads the plugin from a checkout instead of the installed copy (development)."""
    d = os.environ.get("ORCADUCHO_PLUGIN_DIR")
    return ["--plugin-dir", d] if d else []


def claude_argv(role: str, model: str, effort: str | None, name: str, env: dict[str, str], cfg: dict, prompt: str | None = None) -> list[str]:
    """`env K=V … claude …` as an argv list (no shell involved)."""
    env = {**env, "ORCADUCHO_MODEL": model, "ORCADUCHO_PLUGIN_DIR": os.environ.get("ORCADUCHO_PLUGIN_DIR", "")}
    argv = ["env", *(f"{k}={v}" for k, v in env.items() if v)]
    argv += ["claude", *plugin_dir_args(), "--agent", f"{PLUGIN}:{role}", "--model", model, "-n", name]
    if effort:
        argv += ["--effort", effort]
    if cfg.get("advisor") and role != "coordinator":
        argv += ["--advisor", cfg["advisor"]]  # cheap model, stronger advisor at decision points
    argv += list(cfg.get("claudeArgs") or [])
    if prompt:
        argv.append(prompt)
    return argv


def launcher(argv: list[str], key: str) -> str:
    """Write a POSIX sh launcher and return a command any login shell (sh, bash, zsh, fish) runs identically.

    Orca runs `terminal create --command` in the user's shell, and fish does not parse POSIX quoting,
    so the only thing the user's shell sees is `sh "<absolute path>"`.
    """
    d = Path(git("rev-parse", "--absolute-git-dir")) / PLUGIN
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"launch-{slug(key)}.sh"
    f.write_text(f"#!/bin/sh\nexec {shlex.join(argv)}\n")
    if any(c in str(f) for c in '"$`\\'):
        die(f"unsupported character in launcher path: {f}")
    return f'sh "{f}"'


# ---------------------------------------------------------------- start

def coordinator_prompt(objective: str, cfg: dict) -> str | None:
    """The objective plus the standing authorisation an unattended run needs.

    Auto mode reads approvals stated in the conversation, and repos often say outward actions need a
    human request, so the user's go-ahead for the run's own branch and PR is written down once here.
    """
    if not objective:
        return None  # resume: the coordinator continues from .orcaducho/plan.md
    if not cfg.get("autonomous", True):
        return objective
    base = cfg.get("base") or "the configured base branch"
    return (f"{objective}\n\n(orcaducho run, unattended: nobody answers questions or permission prompts. "
            f"You are authorised to create the planned issues, push the run branch and its child branches, "
            f"and open one PR against {base}. Decide product questions yourself as described in your instructions.)")


def cmd_start(a: argparse.Namespace) -> None:
    """Launch the Opus coordinator, named, inside an Orca terminal."""
    objective = " ".join(a.objective).strip()
    cfg = config()
    if a.base:
        cfg["base"] = a.base
    prompt = coordinator_prompt(objective, cfg)
    env = {"ORCADUCHO_ROLE": "coordinator"}
    if not a.name:
        if not os.environ.get("ORCA_TERMINAL_HANDLE"):
            die("run inside an Orca terminal, or pass --name to create a new worktree for the run")
        name = label("coordinator", objective or "session")
        orca("terminal", "rename", "--terminal", os.environ["ORCA_TERMINAL_HANDLE"], "--title", name, check=False)
        argv = claude_argv("coordinator", a.model, a.effort, name, env, cfg, prompt)
        os.execvp(argv[0], argv)

    base = a.base or cfg.get("base") or ""
    wt_args = ["worktree", "create", "--name", a.name, "--no-parent", "--setup", "run"]
    if base:
        wt_args += ["--base-branch", base]
    wt = orca(*wt_args)
    wt_id = find(wt, lambda k, v: k == "id" and isinstance(v, str) and "::" in v)
    if not wt_id:
        die(f"could not read the new worktree id: {json.dumps(wt)[:400]}")
    name = label("coordinator", objective or a.name)
    orca("worktree", "set", "--worktree", f"id:{wt_id}", "--display-name", name, check=False)
    term = orca("terminal", "create", "--worktree", f"id:{wt_id}", "--title", name,
                "--command", launcher(claude_argv("coordinator", a.model, a.effort, name, env, cfg, prompt),
                                      f"coordinator-{a.name}"))
    handle = find(term, lambda k, v: k == "handle" and isinstance(v, str))
    print(json.dumps({"worktree": wt_id, "handle": handle, "name": name}))


# ---------------------------------------------------------------- spawn

def cmd_spawn(a: argparse.Namespace) -> None:
    """Start one named, supervised lead/worker for an existing Orca Task."""
    cfg = config()
    cur = os.environ.get("ORCA_WORKTREE_ID")
    base_sha = git("rev-parse", "HEAD")

    branch = None
    if a.worktree == "new-child":
        branch = a.branch or f"{PLUGIN}/{slug(a.title)}-{a.task[-6:]}"
        wt = orca("worktree", "create", "--name", branch,
                  "--parent-worktree", f"id:{cur}" if cur else "current",
                  "--base-branch", git("rev-parse", "--abbrev-ref", "HEAD"),
                  "--setup", "run")
        wt_id = find(wt, lambda k, v: k == "id" and isinstance(v, str) and "::" in v)
        if not wt_id:
            die(f"could not read the new worktree id: {json.dumps(wt)[:400]}")
        selector = f"id:{wt_id}"
        orca("worktree", "set", "--worktree", selector, "--display-name", label(a.role, a.title), check=False)
    elif a.worktree == "current":
        selector = f"id:{cur}" if cur else "current"
    else:
        selector = a.worktree

    name = label(a.role, a.title)
    env = {
        "ORCADUCHO_ROLE": a.role,
        "ORCADUCHO_TASK": a.task,
        "ORCADUCHO_RISK": a.risk,
        "ORCADUCHO_ISSUE": a.issue or "",
        "ORCADUCHO_OWNS": a.owns or "",
        "ORCADUCHO_BASE": base_sha,
        "ORCADUCHO_READONLY": "1" if a.worktree == "current" else "",
    }
    model = a.model or DEFAULT_MODEL[a.role]
    term = orca("terminal", "create", "--worktree", selector, "--title", name,
                "--command", launcher(claude_argv(a.role, model, a.effort, name, env, cfg), f"{a.role}-{a.task}-{model}"))
    handle = find(term, lambda k, v: k == "handle" and isinstance(v, str) and v.startswith("term_"))
    if not handle:
        die(f"could not read the terminal handle: {json.dumps(term)[:400]}")
    orca("terminal", "wait", "--terminal", handle, "--for", "tui-idle", "--timeout-ms", "120000", check=False)

    ws = ["orchestration", "worker-start", "--task", a.task, "--terminal", handle, "--worktree", selector]
    if a.retry_of:
        ws += ["--retry-of", a.retry_of]
    if a.run:
        ws += ["--run", a.run]
    res = orca(*ws)
    dispatch = find(res, lambda k, v: k in ("dispatchId", "dispatch_id") and isinstance(v, str))
    print(json.dumps({"task": a.task, "dispatch": dispatch, "handle": handle, "worktree": selector, "branch": branch,
                      "agent": f"{PLUGIN}:{a.role}", "model": model, "name": name}))


# ---------------------------------------------------------------- release

def cmd_release(a: argparse.Namespace) -> None:
    """worker-release, then close the terminal orcaducho created.

    `worker-start --terminal` makes Orca treat the terminal as external, so release settles the
    worker but retains the terminal. Close it only after an accepted settlement.
    """
    rel = orca("orchestration", "worker-release", "--dispatch", a.dispatch)
    show = orca("orchestration", "worker-show", "--dispatch", a.dispatch, check=False).get("result") or {}
    worker = show.get("worker") or {}
    handle, state = worker.get("agentTerminalHandle"), worker.get("state")
    external = (show.get("terminalResource") or {}).get("ownershipState") == "external"
    closed = False
    if handle and external and state in ("succeeded", "failed"):
        closed = orca("terminal", "close", "--terminal", handle, check=False).get("ok", False)
    print(json.dumps({"dispatch": a.dispatch, "released": rel.get("ok"), "state": state, "terminal": handle, "closed": closed}))


# ---------------------------------------------------------------- merge

def cmd_merge(a: argparse.Namespace) -> None:
    """Merge a finished child branch into the current branch; abort cleanly on conflict."""
    p = run(["git", "merge", "--no-ff", "--no-edit", a.branch], check=False)
    if p.returncode == 0:
        print(json.dumps({"merged": a.branch, "head": git("rev-parse", "--short", "HEAD")}))
        return
    conflicts = git("diff", "--name-only", "--diff-filter=U", check=False).splitlines()
    run(["git", "merge", "--abort"], check=False)
    print(json.dumps({"merged": False, "branch": a.branch, "conflicts": conflicts}))
    sys.exit(2)


# ---------------------------------------------------------------- review

def cmd_review(a: argparse.Namespace) -> None:
    """Review the whole run branch against its base before the PR (one headless reviewer call)."""
    base = a.base or config().get("base") or "HEAD~1"
    ref = f"origin/{base}" if git("rev-parse", "--verify", "-q", f"origin/{base}", check=False) else base
    diff = git("diff", f"{ref}...HEAD")[:DIFF_LIMIT]
    if not diff:
        print("PASS")
        return
    verdict = review(diff, a.model, f"the whole orcaducho run branch (against {ref}); flag only cross-task defects "
                                    f"such as broken integration between the parts")
    print(verdict or "PASS")
    if verdict.upper().startswith("FAIL"):
        sys.exit(3)


# ---------------------------------------------------------------- issues

def issues_enabled() -> bool:
    if not config().get("issues", True) or not shutil.which("gh"):
        return False
    return run(["gh", "repo", "view", "--json", "hasIssuesEnabled", "-q", ".hasIssuesEnabled"], check=False).stdout.strip() == "true"


def ensure_labels() -> None:
    for name, color in (("orcaducho", "5319e7"), ("risk:low", "0e8a16"), ("risk:med", "fbca04"),
                        ("risk:high", "b60205"), ("status:failed", "d93f0b")):
        run(["gh", "label", "create", name, "--color", color, "--force"], check=False)


TEXT = {
    "en": {
        "risk": {"low": "🟢 low", "med": "🟡 medium", "high": "🔴 high"},
        "task": "orcaducho task · risk {risk}", "part_of": "part of #{n}",
        "Change": "What to do", "Target": "Where", "Ownership": "Files it may change",
        "Constraints": "Constraints", "Acceptance": "Done when", "Notes": "Notes",
        "spec": "🤖 Agent spec (what the worker receives)",
        "epic": "orcaducho run. The tasks are this issue's sub-issues; GitHub shows their progress above.",
        "goal": "Goal", "plan": "🤖 Plan as the coordinator wrote it",
        "outcome": {"succeeded": "✅ {role} · succeeded", "failed": "❌ {role} · failed"},
        "other": "ℹ️ {role} · {outcome}",
    },
    "es": {
        "risk": {"low": "🟢 bajo", "med": "🟡 medio", "high": "🔴 alto"},
        "task": "Tarea de orcaducho · riesgo {risk}", "part_of": "parte de #{n}",
        "Change": "Qué hay que hacer", "Target": "Dónde", "Ownership": "Ficheros que puede tocar",
        "Constraints": "Restricciones", "Acceptance": "Hecho cuando", "Notes": "Notas",
        "spec": "🤖 Especificación para agentes (lo que recibe el worker)",
        "epic": "Ejecución de orcaducho. Las tareas son los sub-issues de este issue; GitHub muestra su progreso arriba.",
        "goal": "Objetivo", "plan": "🤖 Plan tal como lo escribió el coordinador",
        "outcome": {"succeeded": "✅ {role} · completado", "failed": "❌ {role} · fallido"},
        "other": "ℹ️ {role} · {outcome}",
    },
}

# The coordinator writes specs as "Label: text" sections; these are the labels it uses, with aliases.
SPEC_LABELS = {"target": "Target", "change": "Change", "constraints": "Constraints", "ownership": "Ownership",
               "owns": "Ownership", "acceptance": "Acceptance", "observable acceptance": "Acceptance",
               "notes": "Notes"}
SPEC_RE = re.compile(r"^\s*(" + "|".join(sorted(map(re.escape, SPEC_LABELS), key=len, reverse=True)) + r")\s*:\s*",
                     re.IGNORECASE | re.MULTILINE)
SECTION_ORDER = ("Change", "Target", "Ownership", "Constraints", "Acceptance", "Notes")


def text(cfg: dict) -> dict:
    return TEXT.get(str(cfg.get("lang") or "en").lower()[:2], TEXT["en"])


def parse_spec(spec: str) -> tuple[str, dict[str, str]]:
    """Split a compact spec into (intro, {section: text}). Unlabelled text before the first label is the intro."""
    matches = list(SPEC_RE.finditer(spec))
    if not matches:
        return spec.strip(), {}
    sections: dict[str, str] = {}
    for i, m in enumerate(matches):
        end = matches[i + 1].start() if i + 1 < len(matches) else len(spec)
        key = SPEC_LABELS[m.group(1).lower()]
        body = spec[m.end():end].strip()
        sections[key] = f"{sections[key]}\n{body}" if key in sections else body
    return spec[:matches[0].start()].strip(), sections


def split_items(value: str, sep: str) -> list[str]:
    items = [i.strip().rstrip(".").strip() for part in value.splitlines() for i in part.split(sep)]
    return [i.lstrip("-* ").strip() for i in items if i.strip("-* ")]


def fenced(raw: str) -> str:
    fence = "~~~~" if "~~~" in raw else "~~~"
    return f"{fence}text\n{raw.strip()}\n{fence}"


def details(summary: str, raw: str) -> str:
    return f"<details>\n<summary>{summary}</summary>\n\n{fenced(raw)}\n\n</details>"


def render_task(spec: str, risk: str, parent: str | None, cfg: dict) -> str:
    """Human-readable issue body; the compact spec stays verbatim in a collapsed block for agents and audits."""
    t = text(cfg)
    intro, sections = parse_spec(spec)
    if not sections:
        return spec  # nothing structured to render
    head = t["task"].format(risk=t["risk"].get(risk, risk))
    if parent and parent != "-":
        head += " · " + t["part_of"].format(n=parent)
    out = [f"> {head}"]
    if intro:
        out.append(intro)
    for key in SECTION_ORDER:
        value = sections.get(key)
        if not value:
            continue
        if key == "Ownership":
            value = "\n".join(f"- `{g}`" for g in split_items(value, ","))
        elif key == "Acceptance":
            value = "\n".join(f"- [ ] {i}" for i in split_items(value, ";"))
        out.append(f"### {t[key]}\n{value}")
    out.append(details(t["spec"], spec))
    return "\n\n".join(out) + "\n"


def render_epic(body: str, goal: str | None, cfg: dict) -> str:
    t = text(cfg)
    if not goal:
        return f"> {t['epic']}\n\n{body}".rstrip() + "\n"
    out = [f"> {t['epic']}", f"### {t['goal']}\n{goal.strip()}"]
    if body.strip():
        out.append(details(t["plan"], body))
    return "\n\n".join(out) + "\n"


def render_result(role: str, outcome: str, subject: str, body: str, model: str, cfg: dict) -> str:
    t = text(cfg)
    head = t["outcome"].get(outcome, t["other"]).format(role=role, outcome=outcome)
    out = [f"### {head}"]
    if subject:
        out.append(f"**{subject}**")
    if body:
        out.append(body)
    out.append(f"<sub>orcaducho · {model or '?'}</sub>")
    return "\n\n".join(out)


def cmd_issue(a: argparse.Namespace) -> None:
    if not issues_enabled():
        print("-")  # issues off: callers treat "-" as "no issue"
        return
    ensure_labels()
    cfg = config()
    labels = ["--label", "orcaducho"]
    if a.kind == "task":
        labels += ["--label", f"risk:{a.risk}"]
        body = render_task(a.body or "", a.risk, a.parent, cfg)
    else:
        body = render_epic(a.body or "", a.goal, cfg)
    url = run(["gh", "issue", "create", "--title", a.title, "--body", body, *labels]).stdout.strip()
    number = url.rstrip("/").rsplit("/", 1)[-1]
    if a.kind == "task" and a.parent and a.parent != "-":
        repo = run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"]).stdout.strip()
        sub_id = run(["gh", "api", f"repos/{repo}/issues/{number}", "-q", ".id"]).stdout.strip()
        run(["gh", "api", "-X", "POST", f"repos/{repo}/issues/{a.parent}/sub_issues",
             "-F", f"sub_issue_id={sub_id}"], check=False)
    print(number)


def cmd_refresh(a: argparse.Namespace) -> None:
    """Re-render raw-spec issues written by orcaducho < 0.4 (risk from labels, parent from the sub-issue link)."""
    if not issues_enabled():
        die("issues are off for this repo")
    cfg = config()
    repo = run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"]).stdout.strip()
    for n in a.numbers:
        info = json.loads(run(["gh", "issue", "view", n, "--json", "body,labels"]).stdout)
        body = info.get("body") or ""
        if "<details>" in body:
            print(json.dumps({"issue": n, "refreshed": False, "reason": "already rendered"}))
            continue
        risk = next((l["name"][5:] for l in info.get("labels", []) if l["name"].startswith("risk:")), "low")
        parent = run(["gh", "api", f"repos/{repo}/issues/{n}/parent", "-q", ".number"], check=False).stdout.strip() or None
        new = render_task(body, risk, parent, cfg)
        if new != body:
            run(["gh", "issue", "edit", n, "--body", new])
        print(json.dumps({"issue": n, "refreshed": new != body}))


# ---------------------------------------------------------------- hooks

GLOB_CACHE: dict[str, re.Pattern] = {}


def glob_re(pattern: str) -> re.Pattern:
    if pattern not in GLOB_CACHE:
        out, i = "", 0
        while i < len(pattern):
            c = pattern[i]
            if pattern.startswith("**/", i):
                out, i = out + "(?:.*/)?", i + 3
            elif pattern.startswith("**", i):
                out, i = out + ".*", i + 2
            elif c == "*":
                out, i = out + "[^/]*", i + 1
            elif c == "?":
                out, i = out + "[^/]", i + 1
            else:
                out, i = out + re.escape(c), i + 1
        GLOB_CACHE[pattern] = re.compile(out + r"\Z")
    return GLOB_CACHE[pattern]


def deny(reason: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                             "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))
    sys.exit(0)


def is_worker_done(command: str) -> bool:
    return "orchestration send" in command and "worker_done" in command


def hook_guard(event: dict) -> None:
    """Coordinator never edits files; workers only edit what they own."""
    role = os.environ.get("ORCADUCHO_ROLE")
    path = (event.get("tool_input") or {}).get("file_path") or (event.get("tool_input") or {}).get("notebook_path")
    if not path:
        return
    cwd = event.get("cwd") or os.getcwd()
    try:
        rel = Path(path).resolve().relative_to(toplevel(cwd)).as_posix()
    except (ValueError, SystemExit):
        rel = path
    if role == "coordinator":
        if rel.startswith(".orcaducho/") or rel == ".orcaducho.json":
            return
        deny("orcaducho coordinator plans only: dispatch a worker for file changes (only .orcaducho/ and .orcaducho.json are writable).")
    owns = [g.strip() for g in os.environ.get("ORCADUCHO_OWNS", "").split(",") if g.strip()]
    if owns and not any(glob_re(g).match(rel) for g in owns):
        deny(f"{rel} is outside this task's ownership ({', '.join(owns)}). Use `orca orchestration ask` if you need it.")


def gate_failures(add: bool = False) -> int:
    # Keyed by model too, so a Sonnet retry of a task Haiku failed starts with a fresh budget.
    key = f"{os.environ.get('ORCADUCHO_TASK', 'x')}-{os.environ.get('ORCADUCHO_MODEL', 'x')}"
    f = Path(git("rev-parse", "--absolute-git-dir")) / f"orcaducho-gate-{key}"
    n = int(f.read_text()) if f.exists() else 0
    if add:
        n += 1
        f.write_text(str(n))
    return n


def gate_fail(reason: str) -> None:
    n = gate_failures(add=True)
    if n >= MAX_GATE_FAILURES:
        reason += ("\nGate failed twice: do not fix again. Send worker_done with --outcome failed and a "
                   "three-sentence summary of what still fails, so the coordinator can escalate.")
    else:
        reason += "\nFix this once, commit, and send worker_done again."
    deny(reason)


def hook_gate(event: dict) -> None:
    """Before a successful worker_done: clean tree, project checks, risk-tiered review."""
    role = os.environ.get("ORCADUCHO_ROLE")
    command = (event.get("tool_input") or {}).get("command", "")
    if role not in ("worker", "lead") or not is_worker_done(command) or "--outcome succeeded" not in command:
        return
    if gate_failures() >= MAX_GATE_FAILURES:
        deny("Gate already failed twice for this task: send worker_done with --outcome failed.")
    if os.environ.get("ORCADUCHO_READONLY"):
        return  # read-only task in a shared worktree: nothing of its own to gate
    cwd = event.get("cwd") or os.getcwd()
    dirty = [l for l in git("status", "--porcelain", cwd=cwd).splitlines() if not l[3:].startswith(".orcaducho")]
    if dirty:
        deny("Commit all changes (git add -A && git commit) before worker_done.")

    check = config(cwd).get("check")
    if check:
        try:
            p = subprocess.run(check, shell=True, cwd=cwd, capture_output=True, text=True, timeout=900)
        except subprocess.TimeoutExpired:
            gate_fail(f"Checks timed out: {check}")
        if p.returncode != 0:
            tail = "\n".join((p.stdout + p.stderr).strip().splitlines()[-30:])
            gate_fail(f"Checks failed: {check}\n{tail}")

    risk = os.environ.get("ORCADUCHO_RISK", "low")
    if role != "worker" or risk not in REVIEW_MODEL:
        return
    base = os.environ.get("ORCADUCHO_BASE") or "HEAD~1"
    diff = git("diff", f"{base}...HEAD", cwd=cwd)[:DIFF_LIMIT]  # three dots: only this branch's changes
    if not diff:
        return
    verdict = review(diff, REVIEW_MODEL[risk], f"Orca task {os.environ.get('ORCADUCHO_TASK', '')} (risk: {risk})", cwd)
    if verdict.upper().startswith("FAIL"):
        gate_fail(f"{REVIEW_MODEL[risk]} review failed:\n{verdict[:1500]}")


def review(diff: str, model: str, what: str, cwd: str | None = None) -> str:
    """Run the headless reviewer agent on a diff; returns its PASS/FAIL text ("PASS" if it times out)."""
    prompt = f"Review this diff for {what}. Answer per your instructions.\n\n```diff\n{diff}\n```"
    env = {**os.environ, "ORCADUCHO_ROLE": "reviewer"}
    try:
        p = subprocess.run(["claude", "-p", *plugin_dir_args(), "--agent", f"{PLUGIN}:reviewer", "--model", model, prompt],
                           cwd=cwd, capture_output=True, text=True, timeout=600, env=env)
    except subprocess.TimeoutExpired:
        return "PASS"  # a stuck reviewer must not block delivery; checks already passed
    return p.stdout.strip()


AUTONOMY = {
    "coordinator": ("Nobody is watching this orcaducho run. Decide yourself: choose the conservative option that "
                    "keeps the plan moving, record the assumption in .orcaducho/plan.md and on the epic issue as "
                    "\"to confirm\", and continue."),
    "lead": "Nobody is watching this orcaducho run. Ask your coordinator with your preamble's `ask` command instead, or decide yourself.",
    "worker": "Nobody is watching this orcaducho run. Ask the coordinator with your preamble's `ask` command instead, or decide yourself.",
}


def autonomous(event: dict) -> bool:
    return bool(config(event.get("cwd")).get("autonomous", True))


def hook_ask(event: dict) -> None:
    """AskUserQuestion would wait for a human forever: answer it with the escalation route instead."""
    role = os.environ.get("ORCADUCHO_ROLE", "")
    if role in AUTONOMY and autonomous(event):
        deny(AUTONOMY[role])


def hook_permission(event: dict) -> None:
    """A permission prompt would stall an unattended session: deny it and say how to proceed."""
    role = os.environ.get("ORCADUCHO_ROLE", "")
    if role not in AUTONOMY or not autonomous(event):
        return
    escalate = ("record it as blocked in .orcaducho/plan.md and continue with the rest" if role == "coordinator"
                else "report it with your preamble's `ask`, or send worker_done --outcome failed if the task cannot be done without it")
    message = (f"No one approves permission prompts in an orcaducho run, so {event.get('tool_name', 'this tool')} was denied. "
               f"Find a way that needs no approval; otherwise {escalate}.")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                             "decision": {"behavior": "deny", "message": message}}}))


def run_finished(cwd: str | None) -> bool:
    plan = toplevel(cwd) / ".orcaducho" / "plan.md"
    try:
        return bool(re.search(r"^\s*status:\s*(done|stopped)\b", plan.read_text(), re.IGNORECASE | re.MULTILINE))
    except OSError:
        return False


def hook_stop(event: dict) -> None:
    """Keep the coordinator looping until plan.md says the run is done (Claude Code caps consecutive continuations)."""
    if os.environ.get("ORCADUCHO_ROLE") != "coordinator" or not autonomous(event) or run_finished(event.get("cwd")):
        return
    if event.get("background_tasks"):
        return  # background work will wake the session on its own
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": (
        "The orcaducho run is not finished. Continue the coordinator loop (`orca orchestration check --wait ...`). "
        "When every task has settled and the PR is open, add the line `Status: done` to .orcaducho/plan.md; "
        "if the run cannot continue at all, add `Status: stopped` with one line saying why.")}}))


def hook_post(event: dict) -> None:
    """After worker_done: mirror the summary onto the task's GitHub issue (no model tokens)."""
    issue = os.environ.get("ORCADUCHO_ISSUE")
    command = (event.get("tool_input") or {}).get("command", "")
    if not issue or issue == "-" or not is_worker_done(command) or not shutil.which("gh"):
        return
    try:
        argv = shlex.split(command)
    except ValueError:
        return
    opts = {argv[i]: argv[i + 1] for i in range(len(argv) - 1) if argv[i].startswith("--")}
    outcome = opts.get("--outcome", "unknown")
    body = render_result(os.environ.get("ORCADUCHO_ROLE", "?"), outcome, opts.get("--subject", ""),
                         opts.get("--body", ""), os.environ.get("ORCADUCHO_MODEL", ""), config(event.get("cwd")))
    subprocess.Popen(["gh", "issue", "comment", issue, "--body", body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if outcome == "failed":
        subprocess.Popen(["gh", "issue", "edit", issue, "--add-label", "status:failed"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_hook(a: argparse.Namespace) -> None:
    if os.environ.get("ORCADUCHO_ROLE") not in ROLES:
        return  # inert outside orcaducho sessions
    try:
        event = json.load(sys.stdin)
    except json.JSONDecodeError:
        return
    {"guard": hook_guard, "gate": hook_gate, "post": hook_post, "ask": hook_ask,
     "permission": hook_permission, "stop": hook_stop}[a.which](event)


# ---------------------------------------------------------------- init

def detect_check(root: Path) -> str:
    """Guess the fast verification command from the project files, so no agent spends tokens on it."""
    pkg = root / "package.json"
    if pkg.exists():
        try:
            scripts = json.loads(pkg.read_text()).get("scripts") or {}
        except (json.JSONDecodeError, AttributeError):
            scripts = {}
        pm = next((m for f, m in (("pnpm-lock.yaml", "pnpm"), ("yarn.lock", "yarn"), ("bun.lockb", "bun"),
                                  ("bun.lock", "bun")) if (root / f).exists()), "npm")
        run_cmd = "npm run" if pm == "npm" else pm
        steps = [s for s in ("typecheck", "lint", "test") if s in scripts]
        return " && ".join(f"{run_cmd} {s}" for s in steps)
    for marker, cmd in (("Cargo.toml", "cargo check && cargo test"), ("go.mod", "go vet ./... && go test ./..."),
                        ("pyproject.toml", "python3 -m pytest -q")):
        if (root / marker).exists():
            return cmd
    return ""


def cmd_init(a: argparse.Namespace) -> None:
    """Write .orcaducho.json in the repo root and keep .orcaducho/ out of git (locally)."""
    root = toplevel()
    f = root / ".orcaducho.json"
    if f.exists() and not a.force:
        die(f"{f} already exists (use --force to overwrite)")
    base = a.base or git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False).removeprefix("origin/")
    cfg = {"check": a.check if a.check is not None else detect_check(root), "base": base, "issues": not a.no_issues,
           "lang": a.lang, "autonomous": not a.supervised, "advisor": a.advisor or "",
           "claudeArgs": list(SKIP_PERMISSIONS_ARGS if a.skip_permissions else DEFAULT_CLAUDE_ARGS)}
    f.write_text(json.dumps(cfg, indent=2) + "\n")
    exclude = Path(git("rev-parse", "--git-path", "info/exclude"))
    exclude = exclude if exclude.is_absolute() else root / exclude
    exclude.parent.mkdir(parents=True, exist_ok=True)
    if ".orcaducho/" not in (exclude.read_text() if exclude.exists() else ""):
        with exclude.open("a") as fh:
            fh.write("\n.orcaducho/\n")
    print(json.dumps({"config": str(f), **cfg}))
    if not cfg["check"]:
        print("orcaducho: no check command found; pass --check, or the coordinator fills it in on first run", file=sys.stderr)


# ---------------------------------------------------------------- install

def cmd_install(a: argparse.Namespace) -> None:
    target = Path(a.dir).expanduser()
    target.mkdir(parents=True, exist_ok=True)
    link = target / PLUGIN
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(Path(__file__).resolve())
    print(f"{link} -> {Path(__file__).resolve()}")


# ---------------------------------------------------------------- main

def main() -> None:
    ap = argparse.ArgumentParser(prog=PLUGIN, description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start", help="launch the Opus coordinator")
    s.add_argument("objective", nargs="*")
    s.add_argument("--name", help="create a new top-level worktree/branch with this name for the run")
    s.add_argument("--base", help="base branch for --name (default: config base, else repo default)")
    s.add_argument("--model", default=DEFAULT_MODEL["coordinator"])
    s.add_argument("--effort", default=None)
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("spawn", help="start a named, supervised lead/worker for an Orca Task")
    s.add_argument("--role", choices=("lead", "worker"), required=True)
    s.add_argument("--task", required=True)
    s.add_argument("--title", required=True)
    s.add_argument("--model")
    s.add_argument("--effort")
    s.add_argument("--risk", choices=("low", "med", "high"), default="low")
    s.add_argument("--issue")
    s.add_argument("--owns", help="comma-separated globs relative to the repo root")
    s.add_argument("--worktree", default="new-child", help="new-child (default), current, or an Orca selector")
    s.add_argument("--branch")
    s.add_argument("--retry-of")
    s.add_argument("--run")
    s.set_defaults(fn=cmd_spawn)

    s = sub.add_parser("release", help="release a settled worker and close its orcaducho terminal")
    s.add_argument("--dispatch", required=True)
    s.set_defaults(fn=cmd_release)

    s = sub.add_parser("merge", help="merge a child branch into the current branch")
    s.add_argument("branch")
    s.set_defaults(fn=cmd_merge)

    s = sub.add_parser("review", help="review the run branch against its base (exit 3 on FAIL)")
    s.add_argument("--base", help="default: config base")
    s.add_argument("--model", default="sonnet")
    s.set_defaults(fn=cmd_review)

    s = sub.add_parser("issue", help="create an epic or task issue (prints its number, or '-')")
    s.add_argument("kind", choices=("epic", "task"))
    s.add_argument("--title", required=True)
    s.add_argument("--body", help="task: the compact spec (Target/Change/Constraints/Ownership/Acceptance); epic: the plan")
    s.add_argument("--goal", help="epic: one human-readable paragraph; --body then goes in a collapsed block")
    s.add_argument("--parent")
    s.add_argument("--risk", choices=("low", "med", "high"), default="low")
    s.set_defaults(fn=cmd_issue)

    s = sub.add_parser("refresh", help="re-render task issues written as raw specs (orcaducho < 0.4)")
    s.add_argument("numbers", nargs="+")
    s.set_defaults(fn=cmd_refresh)

    s = sub.add_parser("hook", help="Claude Code hook entry point")
    s.add_argument("which", choices=("guard", "gate", "post", "ask", "permission", "stop"))
    s.set_defaults(fn=cmd_hook)

    s = sub.add_parser("init", help="set up the current repo (.orcaducho.json, local ignore)")
    s.add_argument("--check", help="verification command (default: detected from package.json, Cargo.toml, go.mod, pyproject.toml)")
    s.add_argument("--base", help="base branch (default: origin's default branch)")
    s.add_argument("--no-issues", action="store_true", help="do not use GitHub issues")
    s.add_argument("--skip-permissions", action="store_true",
                   help="run agents with --dangerously-skip-permissions instead of auto mode (containers/VMs only)")
    s.add_argument("--lang", default="en", help="language of the issues orcaducho writes: en or es (default en)")
    s.add_argument("--advisor", help="advisor model for leads and workers, e.g. opus (Anthropic API only)")
    s.add_argument("--supervised", action="store_true",
                   help="let agents ask you questions and permission prompts (default: fully autonomous)")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("install", help="symlink this CLI onto PATH")
    s.add_argument("--dir", default="~/.local/bin")
    s.set_defaults(fn=cmd_install)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
