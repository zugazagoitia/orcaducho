#!/usr/bin/env python3
"""orcaducho: launcher, spawner, GitHub-issue sync and hooks for the orcaducho harness.

Every mechanical step lives here so agents spend tokens only on decisions.
Stdlib only; works on macOS and Linux.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

PLUGIN = "orcaducho"
ROLES = ("coordinator", "lead", "worker")
HOOK_ROLES = (*ROLES, "reviewer")
DEFAULT_MODEL = {"coordinator": "opus", "lead": "sonnet", "worker": "haiku"}
REVIEW_MODEL = {"med": "haiku", "high": "sonnet"}
MAX_GATE_FAILURES = 2  # first failure: worker fixes; second: report failed so the coordinator escalates
DIFF_LIMIT = 60_000
# Auto mode: a classifier approves routine actions, so unattended sessions do not stall on prompts.
DEFAULT_CLAUDE_ARGS = ("--permission-mode", "auto")
SKIP_PERMISSIONS_ARGS = ("--dangerously-skip-permissions",)
# Spawned sessions skip the user's MCP connectors, skills, plugins and hooks: a bare call drops from ~25k to ~10k
# tokens of base context, which every call of every worker pays again. orcaducho itself comes back via --plugin-dir.
LEAN_ARGS = ("--strict-mcp-config", "--disable-slash-commands", "--setting-sources", "project,local")
LEAN_ROLES = ("lead", "worker", "reviewer")

# .orcaducho.json keys: default and allowed values (None: any string; bool: true/false; int: a number).
SCHEMA = {
    "check": ("", None),
    "base": ("", None),
    "todo": ("issues", ("issues", "markdown", "none")),
    "depth": ("objective", ("plan", "objective", "epic-approval", "drain")),
    "maxItems": (3, int),
    "ship": ("pr-ready", ("pr-ready", "pr-draft", "local")),
    "autoMerge": (False, bool),
    "lang": ("en", ("en", "es")),
    "autonomous": (True, bool),
    "isolate": (True, bool),
    "advisor": ("", None),
}
BACKLOG = "BACKLOG.md"


# ---------------------------------------------------------------- helpers

def die(msg: str, code: int = 1) -> None:
    print(f"orcaducho: {msg}", file=sys.stderr)
    sys.exit(code)


def orca_exe() -> str:
    """Resolve the Orca CLI exactly as the orca-cli skill prescribes."""
    if os.environ.get("ORCA_CLI_COMMAND"):
        return os.environ["ORCA_CLI_COMMAND"]
    if os.environ.get("ORCA_DEV_REPO_ROOT"):
        return "orca-dev"
    if sys.platform.startswith("linux") and not os.environ.get("ORCA_TERMINAL_HANDLE"):
        return "orca-ide"  # bare `orca` is the GNOME screen reader outside Orca terminals
    return "orca"


def run(cmd: list[str], cwd: str | None = None, check: bool = True, timeout: int | None = None) -> subprocess.CompletedProcess:
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    if check and p.returncode != 0:
        die(f"{shlex.join(cmd)} failed ({p.returncode}): {(p.stderr or p.stdout).strip()[-800:]}")
    return p


def orca(*args: str, check: bool = True) -> dict:
    p = run([orca_exe(), *args, "--json"], check=False)
    try:
        data = json.loads(p.stdout)
    except json.JSONDecodeError:
        data = {"ok": False, "raw": (p.stdout + p.stderr).strip()[-800:]}
    if check and (p.returncode != 0 or not data.get("ok", False)):
        die(f"orca {' '.join(args[:2])} failed: {json.dumps(data.get('error') or data)[:800]}")
    return data


def find(obj, pred):
    """Depth-first search for the first (key, value) pair matching pred."""
    if isinstance(obj, dict):
        for k, v in obj.items():
            if pred(k, v):
                return v
            r = find(v, pred)
            if r is not None:
                return r
    elif isinstance(obj, list):
        for v in obj:
            r = find(v, pred)
            if r is not None:
                return r
    return None


def git(*args: str, cwd: str | None = None, check: bool = True) -> str:
    return run(["git", *args], cwd=cwd, check=check).stdout.strip()


def toplevel(cwd: str | None = None) -> Path:
    return Path(git("rev-parse", "--show-toplevel", cwd=cwd, check=False) or cwd or os.getcwd()).resolve()


def config(cwd: str | None = None) -> dict:
    cfg = {k: d for k, (d, _) in SCHEMA.items()}
    cfg["claudeArgs"] = list(DEFAULT_CLAUDE_ARGS)
    try:
        f = toplevel(cwd) / ".orcaducho.json"
        if f.exists():
            raw = json.loads(f.read_text())
            if "todo" not in raw and raw.get("issues") is False:
                raw["todo"] = "none"  # pre-0.6 configs
            cfg.update(raw)
    except SystemExit:
        pass
    cfg["issues"] = cfg.get("todo") == "issues"
    return cfg


def parse_setting(item: str) -> tuple[str, object]:
    """`key=value` from `init --set`, checked against SCHEMA."""
    key, sep, value = item.partition("=")
    if not sep:
        die(f"--set expects key=value, got {item!r}")
    if key == "claudeArgs":
        return key, shlex.split(value)
    if key not in SCHEMA:
        die(f"unknown setting {key!r} (known: {', '.join(SCHEMA)}, claudeArgs)")
    kind = SCHEMA[key][1]
    if kind is bool:
        if value.lower() not in ("true", "false"):
            die(f"{key} must be true or false")
        return key, value.lower() == "true"
    if kind is int:
        if not value.isdigit():
            die(f"{key} must be a number")
        return key, int(value)
    if isinstance(kind, tuple) and value not in kind:
        die(f"{key} must be one of: {', '.join(kind)}")
    return key, value


def common_dir(cwd: str | None = None) -> Path:
    """orcaducho state shared by every worktree of the repo (session registry, taken backlog items)."""
    d = Path(cwd or os.getcwd()) / git("rev-parse", "--git-common-dir", cwd=cwd) / PLUGIN  # absolute stays absolute
    d.mkdir(parents=True, exist_ok=True)
    return d


def label(role: str, title: str) -> str:
    text = f"{PLUGIN}:{role} · {title}"
    return text if len(text) <= 60 else text[:59] + "…"


def slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "task"


def plugin_dir_args(lean: bool = False) -> list[str]:
    """ORCADUCHO_PLUGIN_DIR loads the plugin from a checkout instead of the installed copy (development).

    Lean sessions do not read user settings, where the plugin is enabled, so they always load it by path.
    """
    d = os.environ.get("ORCADUCHO_PLUGIN_DIR") or (str(Path(__file__).resolve().parent.parent) if lean else "")
    return ["--plugin-dir", d] if d else []


def lean_args(role: str, cfg: dict) -> list[str]:
    return list(LEAN_ARGS) if role in LEAN_ROLES and cfg.get("isolate", True) else []


def claude_argv(role: str, model: str, effort: str | None, name: str, env: dict[str, str], cfg: dict, prompt: str | None = None) -> list[str]:
    """`env K=V … claude …` as an argv list (no shell involved)."""
    env = {**env, "ORCADUCHO_MODEL": model, "ORCADUCHO_PLUGIN_DIR": os.environ.get("ORCADUCHO_PLUGIN_DIR", "")}
    argv = ["env", *(f"{k}={v}" for k, v in env.items() if v)]
    lean = lean_args(role, cfg)
    argv += ["claude", *plugin_dir_args(bool(lean)), *lean, "--agent", f"{PLUGIN}:{role}", "--model", model, "-n", name]
    if effort:
        argv += ["--effort", effort]
    if cfg.get("advisor") and role != "coordinator":
        argv += ["--advisor", cfg["advisor"]]  # cheap model, stronger advisor at decision points
    argv += list(cfg.get("claudeArgs") or [])
    if prompt:
        argv.append(prompt)
    return argv


def launcher(argv: list[str], key: str) -> str:
    """Write a POSIX sh launcher and return a command any login shell (sh, bash, zsh, fish) runs identically.

    Orca runs `terminal create --command` in the user's shell, and fish does not parse POSIX quoting,
    so the only thing the user's shell sees is `sh "<absolute path>"`.
    """
    d = Path(git("rev-parse", "--absolute-git-dir")) / PLUGIN
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"launch-{slug(key)}.sh"
    f.write_text(f"#!/bin/sh\nexec {shlex.join(argv)}\n")
    if any(c in str(f) for c in '"$`\\'):
        die(f"unsupported character in launcher path: {f}")
    return f'sh "{f}"'


# ---------------------------------------------------------------- start

RESUME = "Resume the orcaducho run from .orcaducho/plan.md and Orca's task state. Do not plan again."
DEPTH = {
    "plan": "depth=plan: after step 1 (plan), write `Status: awaiting-approval` in plan.md and stop. "
            "A later `orcaducho start` or a user message to continue is the approval: remove that line and dispatch.",
    "objective": "depth=objective: finish this objective with one PR, then stop.",
    "epic-approval": "depth=epic-approval: when every task of an epic has settled, write `Status: paused` and the "
                     "next epic in plan.md and stop. A later `orcaducho start` or a user message to continue resumes it.",
    "drain": "depth=drain: after the PR, if every task and the review passed and fewer than {max} backlog items "
             "were done in this chain (ORCADUCHO_DRAIN={n}), run `orcaducho backlog next`; for a non-empty result "
             "run `orcaducho backlog take <ref>` and `orcaducho start --name orcaducho/<slug> --drain {next} --item <ref> "
             "\"<title>\"`, then write `Status: done`.",
}


def run_policy(cfg: dict, drain: int = 0) -> str:
    """The repo's run policy, stated once in the first prompt so the coordinator never reads the config."""
    todo = {"issues": "GitHub issues", "markdown": f"{BACKLOG} (refs like E1/T3)", "none": "none (plan.md only)"}
    depth = DEPTH.get(cfg.get("depth") or "objective", DEPTH["objective"])
    return (f"Policy: to-do store = {todo.get(cfg.get('todo'), cfg.get('todo'))}; "
            + depth.format(max=cfg.get("maxItems", 3), n=drain, next=drain + 1)
            + " Ship with `orcaducho ship` (it applies the PR policy).")


def coordinator_prompt(objective: str, cfg: dict, drain: int = 0) -> str:
    """The objective plus the run policy and the standing authorisation an unattended run needs.

    Auto mode reads approvals stated in the conversation, and repos often say outward actions need a
    human request, so the user's go-ahead for the run's own branch and PR is written down once here.
    """
    text = objective or RESUME
    policy = run_policy(cfg, drain)
    if not cfg.get("autonomous", True):
        return f"{text}\n\n({policy})"
    base = cfg.get("base") or "the configured base branch"
    ship = cfg.get("ship") or "pr-ready"
    outward = ("Keep the run branch local: do not push it or open a PR." if ship == "local" else
               f"You are authorised to push the run branch and its child branches and open one "
               f"{'draft ' if ship == 'pr-draft' else ''}PR against {base}"
               + (", with auto-merge enabled." if cfg.get("autoMerge") else "."))
    issues = "You may create the planned issues. " if cfg.get("todo") == "issues" else ""
    return (f"{text}\n\n(orcaducho run, unattended: nobody answers questions or permission prompts. {issues}{outward} "
            f"Decide product questions yourself as described in your instructions. {policy})")


def cmd_start(a: argparse.Namespace) -> None:
    """Launch the Opus coordinator, named, inside an Orca terminal."""
    maybe_update()
    objective = " ".join(a.objective).strip()
    cfg = config()
    if a.base:
        cfg["base"] = a.base
    prompt = coordinator_prompt(objective, cfg, a.drain)
    if a.item:
        prompt += f"\n\nThis objective is backlog item {a.item}; `orcaducho ship` closes it."
    env = {"ORCADUCHO_ROLE": "coordinator", "ORCADUCHO_DRAIN": str(a.drain), "ORCADUCHO_ITEM": a.item or ""}
    if not a.name:
        if not os.environ.get("ORCA_TERMINAL_HANDLE"):
            die("run inside an Orca terminal, or pass --name to create a new worktree for the run")
        name = label("coordinator", objective or "session")
        orca("terminal", "rename", "--terminal", os.environ["ORCA_TERMINAL_HANDLE"], "--title", name, check=False)
        argv = claude_argv("coordinator", a.model, a.effort, name, env, cfg, prompt)
        os.execvp(argv[0], argv)

    base = a.base or cfg.get("base") or ""
    wt_args = ["worktree", "create", "--name", a.name, "--no-parent", "--setup", "run"]
    if base:
        wt_args += ["--base-branch", base]
    wt = orca(*wt_args)
    wt_id = find(wt, lambda k, v: k == "id" and isinstance(v, str) and "::" in v)
    if not wt_id:
        die(f"could not read the new worktree id: {json.dumps(wt)[:400]}")
    name = label("coordinator", objective or a.name)
    orca("worktree", "set", "--worktree", f"id:{wt_id}", "--display-name", name, check=False)
    term = orca("terminal", "create", "--worktree", f"id:{wt_id}", "--title", name,
                "--command", launcher(claude_argv("coordinator", a.model, a.effort, name, env, cfg, prompt),
                                      f"coordinator-{a.name}"))
    handle = find(term, lambda k, v: k == "handle" and isinstance(v, str))
    print(json.dumps({"worktree": wt_id, "handle": handle, "name": name}))


# ---------------------------------------------------------------- spawn

def cmd_spawn(a: argparse.Namespace) -> None:
    """Start one named, supervised lead/worker for an existing Orca Task."""
    cfg = config()
    cur = os.environ.get("ORCA_WORKTREE_ID")
    base_sha = git("rev-parse", "HEAD")

    branch = None
    if a.worktree == "new-child":
        branch = a.branch or f"{PLUGIN}/{slug(a.title)}-{a.task[-6:]}"
        wt = orca("worktree", "create", "--name", branch,
                  "--parent-worktree", f"id:{cur}" if cur else "current",
                  "--base-branch", git("rev-parse", "--abbrev-ref", "HEAD"),
                  "--setup", "run")
        wt_id = find(wt, lambda k, v: k == "id" and isinstance(v, str) and "::" in v)
        if not wt_id:
            die(f"could not read the new worktree id: {json.dumps(wt)[:400]}")
        selector = f"id:{wt_id}"
        orca("worktree", "set", "--worktree", selector, "--display-name", label(a.role, a.title), check=False)
    elif a.worktree == "current":
        selector = f"id:{cur}" if cur else "current"
    else:
        selector = a.worktree

    name = label(a.role, a.title)
    env = {
        "ORCADUCHO_ROLE": a.role,
        "ORCADUCHO_TASK": a.task,
        "ORCADUCHO_RISK": a.risk,
        "ORCADUCHO_ISSUE": a.issue or "",
        "ORCADUCHO_OWNS": a.owns or "",
        "ORCADUCHO_BASE": base_sha,
        "ORCADUCHO_READONLY": "1" if a.worktree == "current" else "",
    }
    model = a.model or DEFAULT_MODEL[a.role]
    term = orca("terminal", "create", "--worktree", selector, "--title", name,
                "--command", launcher(claude_argv(a.role, model, a.effort, name, env, cfg), f"{a.role}-{a.task}-{model}"))
    handle = find(term, lambda k, v: k == "handle" and isinstance(v, str) and v.startswith("term_"))
    if not handle:
        die(f"could not read the terminal handle: {json.dumps(term)[:400]}")
    orca("terminal", "wait", "--terminal", handle, "--for", "tui-idle", "--timeout-ms", "120000", check=False)

    ws = ["orchestration", "worker-start", "--task", a.task, "--terminal", handle, "--worktree", selector]
    if a.retry_of:
        ws += ["--retry-of", a.retry_of]
    if a.run:
        ws += ["--run", a.run]
    res = orca(*ws)
    dispatch = find(res, lambda k, v: k in ("dispatchId", "dispatch_id") and isinstance(v, str))
    print(json.dumps({"task": a.task, "dispatch": dispatch, "handle": handle, "worktree": selector, "branch": branch,
                      "agent": f"{PLUGIN}:{a.role}", "model": model, "name": name}))


# ---------------------------------------------------------------- release

def cmd_release(a: argparse.Namespace) -> None:
    """worker-release, then close the terminal orcaducho created.

    `worker-start --terminal` makes Orca treat the terminal as external, so release settles the
    worker but retains the terminal. Close it only after an accepted settlement.
    """
    rel = orca("orchestration", "worker-release", "--dispatch", a.dispatch)
    show = orca("orchestration", "worker-show", "--dispatch", a.dispatch, check=False).get("result") or {}
    worker = show.get("worker") or {}
    handle, state = worker.get("agentTerminalHandle"), worker.get("state")
    external = (show.get("terminalResource") or {}).get("ownershipState") == "external"
    closed = False
    if handle and external and state in ("succeeded", "failed"):
        closed = orca("terminal", "close", "--terminal", handle, check=False).get("ok", False)
    print(json.dumps({"dispatch": a.dispatch, "released": rel.get("ok"), "state": state, "terminal": handle, "closed": closed}))


# ---------------------------------------------------------------- merge

def cmd_merge(a: argparse.Namespace) -> None:
    """Merge a finished child branch into the current branch; abort cleanly on conflict."""
    p = run(["git", "merge", "--no-ff", "--no-edit", a.branch], check=False)
    if p.returncode == 0:
        print(json.dumps({"merged": a.branch, "head": git("rev-parse", "--short", "HEAD")}))
        return
    conflicts = git("diff", "--name-only", "--diff-filter=U", check=False).splitlines()
    run(["git", "merge", "--abort"], check=False)
    print(json.dumps({"merged": False, "branch": a.branch, "conflicts": conflicts}))
    sys.exit(2)


# ---------------------------------------------------------------- review

def cmd_review(a: argparse.Namespace) -> None:
    """Review the whole run branch against its base before the PR (one headless reviewer call)."""
    base = a.base or config().get("base") or "HEAD~1"
    ref = f"origin/{base}" if git("rev-parse", "--verify", "-q", f"origin/{base}", check=False) else base
    diff = git("diff", f"{ref}...HEAD")[:DIFF_LIMIT]
    if not diff:
        print("PASS")
        return
    verdict = review(diff, a.model, f"the whole orcaducho run branch (against {ref}); flag only cross-task defects "
                                    f"such as broken integration between the parts")
    print(verdict or "PASS")
    if verdict.upper().startswith("FAIL"):
        sys.exit(3)


# ---------------------------------------------------------------- issues

def issues_enabled() -> bool:
    if not config().get("issues", True) or not shutil.which("gh"):
        return False
    return run(["gh", "repo", "view", "--json", "hasIssuesEnabled", "-q", ".hasIssuesEnabled"], check=False).stdout.strip() == "true"


def ensure_labels() -> None:
    for name, color in (("orcaducho", "5319e7"), ("risk:low", "0e8a16"), ("risk:med", "fbca04"),
                        ("risk:high", "b60205"), ("status:failed", "d93f0b")):
        run(["gh", "label", "create", name, "--color", color, "--force"], check=False)


TEXT = {
    "en": {
        "risk": {"low": "🟢 low", "med": "🟡 medium", "high": "🔴 high"},
        "task": "orcaducho task · risk {risk}", "part_of": "part of #{n}",
        "Change": "What to do", "Target": "Where", "Ownership": "Files it may change",
        "Constraints": "Constraints", "Acceptance": "Done when", "Notes": "Notes",
        "spec": "🤖 Agent spec (what the worker receives)",
        "epic": "orcaducho run. The tasks are this issue's sub-issues; GitHub shows their progress above.",
        "goal": "Goal", "plan": "🤖 Plan as the coordinator wrote it",
        "outcome": {"succeeded": "✅ {role} · succeeded", "failed": "❌ {role} · failed"},
        "other": "ℹ️ {role} · {outcome}",
    },
    "es": {
        "risk": {"low": "🟢 bajo", "med": "🟡 medio", "high": "🔴 alto"},
        "task": "Tarea de orcaducho · riesgo {risk}", "part_of": "parte de #{n}",
        "Change": "Qué hay que hacer", "Target": "Dónde", "Ownership": "Ficheros que puede tocar",
        "Constraints": "Restricciones", "Acceptance": "Hecho cuando", "Notes": "Notas",
        "spec": "🤖 Especificación para agentes (lo que recibe el worker)",
        "epic": "Ejecución de orcaducho. Las tareas son los sub-issues de este issue; GitHub muestra su progreso arriba.",
        "goal": "Objetivo", "plan": "🤖 Plan tal como lo escribió el coordinador",
        "outcome": {"succeeded": "✅ {role} · completado", "failed": "❌ {role} · fallido"},
        "other": "ℹ️ {role} · {outcome}",
    },
}

# The coordinator writes specs as "Label: text" sections; these are the labels it uses, with aliases.
SPEC_LABELS = {"target": "Target", "change": "Change", "constraints": "Constraints", "ownership": "Ownership",
               "owns": "Ownership", "acceptance": "Acceptance", "observable acceptance": "Acceptance",
               "notes": "Notes"}
SPEC_RE = re.compile(r"^\s*(" + "|".join(sorted(map(re.escape, SPEC_LABELS), key=len, reverse=True)) + r")\s*:\s*",
                     re.IGNORECASE | re.MULTILINE)
SECTION_ORDER = ("Change", "Target", "Ownership", "Constraints", "Acceptance", "Notes")


def text(cfg: dict) -> dict:
    return TEXT.get(str(cfg.get("lang") or "en").lower()[:2], TEXT["en"])


def parse_spec(spec: str) -> tuple[str, dict[str, str]]:
    """Split a compact spec into (intro, {section: text}). Unlabelled text before the first label is the intro."""
    matches = list(SPEC_RE.finditer(spec))
    if not matches:
        return spec.strip(), {}
    sections: dict[str, str] = {}
    for i, m in enumerate(matches):
        end = matches[i + 1].start() if i + 1 < len(matches) else len(spec)
        key = SPEC_LABELS[m.group(1).lower()]
        body = spec[m.end():end].strip()
        sections[key] = f"{sections[key]}\n{body}" if key in sections else body
    return spec[:matches[0].start()].strip(), sections


def split_items(value: str, sep: str) -> list[str]:
    items = [i.strip().rstrip(".").strip() for part in value.splitlines() for i in part.split(sep)]
    return [i.lstrip("-* ").strip() for i in items if i.strip("-* ")]


def fenced(raw: str) -> str:
    fence = "~~~~" if "~~~" in raw else "~~~"
    return f"{fence}text\n{raw.strip()}\n{fence}"


def details(summary: str, raw: str) -> str:
    return f"<details>\n<summary>{summary}</summary>\n\n{fenced(raw)}\n\n</details>"


def render_task(spec: str, risk: str, parent: str | None, cfg: dict) -> str:
    """Human-readable issue body; the compact spec stays verbatim in a collapsed block for agents and audits."""
    t = text(cfg)
    intro, sections = parse_spec(spec)
    if not sections:
        return spec  # nothing structured to render
    head = t["task"].format(risk=t["risk"].get(risk, risk))
    if parent and parent != "-":
        head += " · " + t["part_of"].format(n=parent)
    out = [f"> {head}"]
    if intro:
        out.append(intro)
    for key in SECTION_ORDER:
        value = sections.get(key)
        if not value:
            continue
        if key == "Ownership":
            value = "\n".join(f"- `{g}`" for g in split_items(value, ","))
        elif key == "Acceptance":
            value = "\n".join(f"- [ ] {i}" for i in split_items(value, ";"))
        out.append(f"### {t[key]}\n{value}")
    out.append(details(t["spec"], spec))
    return "\n\n".join(out) + "\n"


def render_epic(body: str, goal: str | None, cfg: dict) -> str:
    t = text(cfg)
    if not goal:
        return f"> {t['epic']}\n\n{body}".rstrip() + "\n"
    out = [f"> {t['epic']}", f"### {t['goal']}\n{goal.strip()}"]
    if body.strip():
        out.append(details(t["plan"], body))
    return "\n\n".join(out) + "\n"


def render_result(role: str, outcome: str, subject: str, body: str, model: str, cfg: dict) -> str:
    t = text(cfg)
    head = t["outcome"].get(outcome, t["other"]).format(role=role, outcome=outcome)
    out = [f"### {head}"]
    if subject:
        out.append(f"**{subject}**")
    if body:
        out.append(body)
    out.append(f"<sub>orcaducho · {model or '?'}</sub>")
    return "\n\n".join(out)


PATH_RE = re.compile(r"[\w.-]+/[\w./-]+|[\w-]+\.\w{1,5}\b")


def warn_unnamed_target(spec: str) -> None:
    """A spec that names the file (and symbol) gets right answers far more often than a vague one."""
    target = parse_spec(spec)[1].get("Target", "")
    if not PATH_RE.search(target):
        print("orcaducho: Target names no file; write it as path::symbol so the worker opens the right code",
              file=sys.stderr)


def git_commit_file(root: Path, name: str, message: str) -> None:
    run(["git", "add", name], cwd=str(root))
    run(["git", "commit", "-q", "-m", message, "--", name], cwd=str(root), check=False)


def backlog_file(root: Path) -> Path:
    f = root / BACKLOG
    if not f.exists():
        f.write_text("# Backlog\n\n## Todo\n\n## Runs\n")
    return f


def markdown_issue(a: argparse.Namespace) -> str:
    """Record an epic or task in BACKLOG.md instead of GitHub; returns its ref (E1, T3)."""
    root = toplevel()
    f = backlog_file(root)
    body = f.read_text()
    prefix = "E" if a.kind == "epic" else "T"
    used = [int(n) for n in re.findall(rf"\b{prefix}(\d+) ·", body)]
    ref = f"{prefix}{max(used or [0]) + 1}"
    if a.kind == "epic":
        goal = f"\n{a.goal.strip()}\n" if a.goal else ""
        body = body.rstrip("\n") + f"\n\n### {ref} · {a.title}\n{goal}"
    else:
        target = parse_spec(a.body or "")[1].get("Target", "").splitlines()
        line = f"- [ ] {ref} · {a.title} · risk {a.risk}" + (f" · {target[0].strip()}" if target else "")
        head = re.search(rf"^### {re.escape(a.parent or '')} · .*$", body, re.MULTILINE) if a.parent else None
        if head:
            nxt = re.search(r"^#{2,3} ", body[head.end():], re.MULTILINE)
            at = head.end() + nxt.start() if nxt else len(body)
            body = body[:at].rstrip("\n") + f"\n{line}\n" + ("\n" + body[at:] if nxt else "")
        else:
            body = body.rstrip("\n") + f"\n{line}\n"
    f.write_text(body.rstrip("\n") + "\n")
    git_commit_file(root, BACKLOG, f"backlog: {ref} {a.title}"[:72])
    return ref


def cmd_issue(a: argparse.Namespace) -> None:
    if a.kind == "task":
        warn_unnamed_target(a.body or "")
    todo = config().get("todo")
    if todo == "markdown" and os.environ.get("ORCADUCHO_ROLE") != "lead":
        print(markdown_issue(a))  # a lead's child tasks live in Orca only, so two branches never edit BACKLOG.md
        return
    if not issues_enabled():
        print("-")  # issues off: callers treat "-" as "no issue"
        return
    ensure_labels()
    cfg = config()
    labels = ["--label", "orcaducho"]
    if a.kind == "task":
        labels += ["--label", f"risk:{a.risk}"]
        body = render_task(a.body or "", a.risk, a.parent, cfg)
    else:
        body = render_epic(a.body or "", a.goal, cfg)
    url = run(["gh", "issue", "create", "--title", a.title, "--body", body, *labels]).stdout.strip()
    number = url.rstrip("/").rsplit("/", 1)[-1]
    if a.kind == "task" and a.parent and a.parent != "-":
        repo = run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"]).stdout.strip()
        sub_id = run(["gh", "api", f"repos/{repo}/issues/{number}", "-q", ".id"]).stdout.strip()
        run(["gh", "api", "-X", "POST", f"repos/{repo}/issues/{a.parent}/sub_issues",
             "-F", f"sub_issue_id={sub_id}"], check=False)
    print(number)


def cmd_done(a: argparse.Namespace) -> None:
    """Mark a task's record finished: tick it in BACKLOG.md, or label a failed GitHub issue."""
    ref = a.ref.lstrip("#")
    if ref.isdigit():
        if a.failed and issues_enabled():
            run(["gh", "issue", "edit", ref, "--add-label", "status:failed"], check=False)
        print(json.dumps({"ref": a.ref, "failed": a.failed}))
        return
    if ref == "-":
        return
    root = toplevel()
    f = root / BACKLOG
    body = f.read_text() if f.exists() else ""
    new = re.sub(rf"^(\s*- )\[ \]( {re.escape(ref)} ·)", rf"\g<1>[{'!' if a.failed else 'x'}]\2", body, flags=re.MULTILINE)
    if new != body:
        f.write_text(new)
        git_commit_file(root, BACKLOG, f"backlog: {ref} {'failed' if a.failed else 'done'}")
    print(json.dumps({"ref": a.ref, "failed": a.failed, "updated": new != body}))


def cmd_refresh(a: argparse.Namespace) -> None:
    """Re-render raw-spec issues written by orcaducho < 0.4 (risk from labels, parent from the sub-issue link)."""
    if not issues_enabled():
        die("issues are off for this repo")
    cfg = config()
    repo = run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"]).stdout.strip()
    for n in a.numbers:
        info = json.loads(run(["gh", "issue", "view", n, "--json", "body,labels"]).stdout)
        body = info.get("body") or ""
        if "<details>" in body:
            print(json.dumps({"issue": n, "refreshed": False, "reason": "already rendered"}))
            continue
        risk = next((l["name"][5:] for l in info.get("labels", []) if l["name"].startswith("risk:")), "low")
        parent = run(["gh", "api", f"repos/{repo}/issues/{n}/parent", "-q", ".number"], check=False).stdout.strip() or None
        new = render_task(body, risk, parent, cfg)
        if new != body:
            run(["gh", "issue", "edit", n, "--body", new])
        print(json.dumps({"issue": n, "refreshed": new != body}))


# ---------------------------------------------------------------- backlog (depth=drain)

TODO_RE = re.compile(r"^\s*- \[ \] (.+)$", re.MULTILINE)


def taken_refs() -> set[str]:
    try:
        return set(json.loads((common_dir() / "taken.json").read_text()))
    except (OSError, json.JSONDecodeError):
        return set()


def todo_items(body: str) -> list[tuple[str, str]]:
    """Open items under `## Todo` in BACKLOG.md as (ref, text); the ref is a hash, so editing text makes a new item."""
    m = re.search(r"^## Todo\s*$(.*?)(?=^## |\Z)", body, re.MULTILINE | re.DOTALL)
    return [("todo:" + hashlib.sha1(t.strip().encode()).hexdigest()[:8], t.strip())
            for t in TODO_RE.findall(m.group(1) if m else "")]


def cmd_backlog(a: argparse.Namespace) -> None:
    cfg = config()
    todo = cfg.get("todo")
    if todo == "none":
        die("todo is none: there is no backlog to drain (orcaducho init --set todo=issues|markdown)")
    if a.action in ("add", "take") and not a.ref:
        die(f"backlog {a.action} needs an argument")
    if a.action == "add":
        if todo == "issues":
            run(["gh", "label", "create", "backlog", "--color", "c5def5", "--force"], check=False)
            print(run(["gh", "issue", "create", "--title", a.ref, "--body", "", "--label", "backlog"]).stdout.strip())
        else:
            f = backlog_file(toplevel())
            body = f.read_text()
            m = re.search(r"^## Todo\s*$\n?", body, re.MULTILINE)
            at = m.end() if m else len(body)
            items = list(re.finditer(r"^\s*- \[.\] .+$", body[at:].split("\n## ", 1)[0], re.MULTILINE))
            at += items[-1].end() + 1 if items else 0
            f.write_text(body[:at] + f"- [ ] {a.ref}\n" + body[at:])
            print(json.dumps({"added": a.ref}))
        return
    taken = taken_refs()
    if a.action == "next":
        if todo == "issues":
            rows = json.loads(run(["gh", "issue", "list", "--label", "backlog", "--state", "open", "-L", "100",
                                   "--json", "number,title,body"]).stdout or "[]")
            items = [(f"#{r['number']}", r["title"], r.get("body") or "") for r in sorted(rows, key=lambda r: r["number"])]
        else:
            f = toplevel() / BACKLOG
            items = [(ref, t, "") for ref, t in todo_items(f.read_text() if f.exists() else "")]
        nxt = next((i for i in items if i[0] not in taken), None)
        print(json.dumps({"ref": nxt[0], "title": nxt[1], "body": nxt[2][:2000]}) if nxt else "")
        return
    if a.action == "take":
        (common_dir() / "taken.json").write_text(json.dumps(sorted(taken | {a.ref})))
        if a.ref.startswith("#") and todo == "issues":
            run(["gh", "issue", "edit", a.ref[1:], "--remove-label", "backlog", "--add-label", "orcaducho"], check=False)
        print(json.dumps({"taken": a.ref}))


# ---------------------------------------------------------------- ship

def cmd_ship(a: argparse.Namespace) -> None:
    """Deliver the run branch as the repo's policy says: local branch, draft PR or ready PR, optionally auto-merged."""
    cfg = config()
    root = toplevel()
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    item, body = os.environ.get("ORCADUCHO_ITEM", ""), a.body or ""
    if item.startswith("todo:"):
        f = root / BACKLOG
        text = dict(todo_items(f.read_text() if f.exists() else "")).get(item)
        if text:
            f.write_text(re.sub(rf"^(\s*- )\[ \] {re.escape(text)}$", rf"\g<1>[x] {text}", f.read_text(),
                                count=1, flags=re.MULTILINE))
            git_commit_file(root, BACKLOG, f"backlog: done {text}"[:72])
    elif item.startswith("#"):
        body += f"\n\nCloses {item}"
    out = {"branch": branch, "ship": cfg.get("ship")}
    if cfg.get("ship") == "local":
        print(json.dumps({**out, "pushed": False}))
        return
    run(["git", "push", "-u", "origin", branch])
    draft = cfg.get("ship") == "pr-draft"
    pr = ["gh", "pr", "create", "--head", branch, "--title", a.title, "--body", body]
    if cfg.get("base"):
        pr += ["--base", cfg["base"]]
    url = run(pr + (["--draft"] if draft else [])).stdout.strip().splitlines()[-1]
    out.update(pushed=True, pr=url, autoMerge=False)
    if cfg.get("autoMerge") and not draft:  # GitHub does not auto-merge drafts
        out["autoMerge"] = run(["gh", "pr", "merge", url, "--auto", "--squash"], check=False).returncode == 0
    print(json.dumps(out))


# ---------------------------------------------------------------- cost

USAGE_KEYS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")


def transcript_usage(path: Path) -> dict[str, dict[str, int]]:
    """Tokens per model in one transcript and its subagents', counting each API message once."""
    totals: dict[str, dict[str, int]] = {}
    seen: set[str] = set()
    sub = path.with_suffix("") / "subagents"
    for f in [path, *(sorted(sub.glob("*.jsonl")) if sub.is_dir() else [])]:
        try:
            lines = f.read_text().splitlines()
        except OSError:
            continue
        for line in lines:
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            msg = row.get("message") if isinstance(row, dict) and row.get("type") == "assistant" else None
            if not isinstance(msg, dict) or not msg.get("usage") or msg.get("id") in seen:
                continue
            seen.add(msg.get("id"))
            t = totals.setdefault(msg.get("model") or "?", dict.fromkeys(USAGE_KEYS, 0))
            for k in USAGE_KEYS:
                t[k] += int(msg["usage"].get(k) or 0)
    return totals


def cmd_cost(a: argparse.Namespace) -> None:
    """Token usage of orcaducho sessions in this repo, by role and model (from the transcripts)."""
    since = time.time() - a.hours * 3600 if a.hours else 0
    sessions: dict[str, dict] = {}
    try:
        for line in (common_dir() / "sessions.jsonl").read_text().splitlines():
            row = json.loads(line)
            if row.get("ts", 0) >= since:
                sessions.setdefault(row["transcript"], row)
    except (OSError, json.JSONDecodeError):
        pass
    table: dict[tuple[str, str], dict[str, int]] = {}
    for path, row in sessions.items():
        for model, t in transcript_usage(Path(path)).items():
            cell = table.setdefault((row.get("role") or "?", model), {"sessions": 0, **dict.fromkeys(USAGE_KEYS, 0)})
            cell["sessions"] += 1
            for k in USAGE_KEYS:
                cell[k] += t[k]
    rows = [{"role": r, "model": m, **c, "total": sum(c[k] for k in USAGE_KEYS)} for (r, m), c in sorted(table.items())]
    if a.json:
        print(json.dumps(rows))
        return
    if not rows:
        print("no orcaducho sessions recorded yet")
        return
    head = ("role", "model", "sessions", "input", "cache write", "cache read", "output", "total")
    cells = [[r["role"], r["model"], r["sessions"], *(r[k] for k in USAGE_KEYS), r["total"]] for r in rows]
    cells.append(["all", "", sum(r["sessions"] for r in rows), *(sum(r[k] for r in rows) for k in USAGE_KEYS),
                  sum(r["total"] for r in rows)])
    fmt = [lambda v: str(v)] * 3 + [lambda v: f"{v:,}"] * 5
    text_rows = [list(head)] + [[f(v) for f, v in zip(fmt, c)] for c in cells]
    widths = [max(len(r[i]) for r in text_rows) for i in range(len(head))]
    for r in text_rows:
        print("  ".join(v.ljust(w) if i < 2 else v.rjust(w) for i, (v, w) in enumerate(zip(r, widths))))


# ---------------------------------------------------------------- audit

def base_tokens(extra: list[str], cwd: str) -> int | None:
    """Tokens a bare "ok" costs on Haiku: the base context every call of a session pays again."""
    try:
        p = subprocess.run(["claude", "-p", "--model", "haiku", *extra, "--output-format", "json", "ok"],
                           cwd=cwd, capture_output=True, text=True, timeout=180)
        usage = json.loads(p.stdout).get("modelUsage") or {}
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None
    return sum(u.get(k, 0) for u in usage.values() for k in ("inputTokens", "cacheReadInputTokens", "cacheCreationInputTokens"))


def cmd_audit(a: argparse.Namespace) -> None:
    """Report (never edit) what inflates the base context of every Claude session on this machine and in this repo."""
    home, root = claude_dir(), toplevel()

    def size(f: Path) -> int:
        return f.stat().st_size if f.is_file() else 0

    def read_json(f: Path) -> dict:
        try:
            return json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            return {}
    settings, state = read_json(home / "settings.json"), read_json(Path.home() / ".claude.json")
    mcp = list((state.get("mcpServers") or {})) + list(((state.get("projects") or {}).get(str(root)) or {}).get("mcpServers") or {})
    facts = {
        "userClaudeMdBytes": size(home / "CLAUDE.md"),
        "projectClaudeMdBytes": size(root / "CLAUDE.md") + size(root / ".claude" / "CLAUDE.md"),
        "userSkills": len([d for d in (home / "skills").glob("*/SKILL.md")]),
        "enabledPlugins": [k for k, v in (settings.get("enabledPlugins") or {}).items() if v],
        "localMcpServers": mcp,
    }
    tips = []
    if facts["userClaudeMdBytes"] > 4000:
        tips.append("~/.claude/CLAUDE.md is over 4 KB and loads into every call of every session: move long rules into skills.")
    if facts["projectClaudeMdBytes"] > 4000:
        tips.append("The project CLAUDE.md is over 4 KB: keep a short repo guide and move the rest into skills or .claude/rules/.")
    if len(facts["enabledPlugins"]) > 8:
        tips.append("Many plugins are enabled; their skills and hooks join every session. Disable the ones you rarely use.")
    if len(mcp) > 3:
        tips.append("Several MCP servers are configured; turn off the ones you do not use, or prefer CLIs like gh.")
    if a.measure and shutil.which("claude"):
        facts["baseTokens"] = {"default": base_tokens([], str(root)),
                               "lean": base_tokens(["--strict-mcp-config", "--disable-slash-commands"], str(root))}
        full, lean = facts["baseTokens"]["default"], facts["baseTokens"]["lean"]
        if full and lean and full - lean > 5000:
            tips.append(f"Your skills and MCP connectors add {full - lean:,} tokens to every call of every interactive "
                        f"session ({full:,} vs {lean:,}). orcaducho workers already skip them (isolate); for your own "
                        f"sessions, disable what you rarely use.")
    print(json.dumps({"facts": facts, "suggestions": tips}, indent=2))


# ---------------------------------------------------------------- hooks

GLOB_CACHE: dict[str, re.Pattern] = {}


def glob_re(pattern: str) -> re.Pattern:
    if pattern not in GLOB_CACHE:
        out, i = "", 0
        while i < len(pattern):
            c = pattern[i]
            if pattern.startswith("**/", i):
                out, i = out + "(?:.*/)?", i + 3
            elif pattern.startswith("**", i):
                out, i = out + ".*", i + 2
            elif c == "*":
                out, i = out + "[^/]*", i + 1
            elif c == "?":
                out, i = out + "[^/]", i + 1
            else:
                out, i = out + re.escape(c), i + 1
        GLOB_CACHE[pattern] = re.compile(out + r"\Z")
    return GLOB_CACHE[pattern]


def deny(reason: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                             "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))
    sys.exit(0)


def is_worker_done(command: str) -> bool:
    return "orchestration send" in command and "worker_done" in command


def hook_guard(event: dict) -> None:
    """Coordinator never edits files; workers only edit what they own."""
    role = os.environ.get("ORCADUCHO_ROLE")
    path = (event.get("tool_input") or {}).get("file_path") or (event.get("tool_input") or {}).get("notebook_path")
    if not path:
        return
    cwd = event.get("cwd") or os.getcwd()
    try:
        rel = Path(path).resolve().relative_to(toplevel(cwd)).as_posix()
    except (ValueError, SystemExit):
        rel = path
    if role == "coordinator":
        if rel.startswith(".orcaducho/") or rel == ".orcaducho.json":
            return
        deny("orcaducho coordinator plans only: dispatch a worker for file changes (only .orcaducho/ and .orcaducho.json are writable).")
    owns = [g.strip() for g in os.environ.get("ORCADUCHO_OWNS", "").split(",") if g.strip()]
    if owns and not any(glob_re(g).match(rel) for g in owns):
        deny(f"{rel} is outside this task's ownership ({', '.join(owns)}). Use `orca orchestration ask` if you need it.")


def gate_failures(add: bool = False) -> int:
    # Keyed by model too, so a Sonnet retry of a task Haiku failed starts with a fresh budget.
    key = f"{os.environ.get('ORCADUCHO_TASK', 'x')}-{os.environ.get('ORCADUCHO_MODEL', 'x')}"
    f = Path(git("rev-parse", "--absolute-git-dir")) / f"orcaducho-gate-{key}"
    n = int(f.read_text()) if f.exists() else 0
    if add:
        n += 1
        f.write_text(str(n))
    return n


def gate_fail(reason: str) -> None:
    n = gate_failures(add=True)
    if n >= MAX_GATE_FAILURES:
        reason += ("\nGate failed twice: do not fix again. Send worker_done with --outcome failed and a "
                   "three-sentence summary of what still fails, so the coordinator can escalate.")
    else:
        reason += "\nFix this once, commit, and send worker_done again."
    deny(reason)


def hook_gate(event: dict) -> None:
    """Before a successful worker_done: clean tree, project checks, risk-tiered review."""
    role = os.environ.get("ORCADUCHO_ROLE")
    command = (event.get("tool_input") or {}).get("command", "")
    if role not in ("worker", "lead") or not is_worker_done(command) or "--outcome succeeded" not in command:
        return
    if gate_failures() >= MAX_GATE_FAILURES:
        deny("Gate already failed twice for this task: send worker_done with --outcome failed.")
    if os.environ.get("ORCADUCHO_READONLY"):
        return  # read-only task in a shared worktree: nothing of its own to gate
    cwd = event.get("cwd") or os.getcwd()
    dirty = [l for l in git("status", "--porcelain", cwd=cwd).splitlines() if not l[3:].startswith(".orcaducho")]
    if dirty:
        deny("Commit all changes (git add -A && git commit) before worker_done.")

    check = config(cwd).get("check")
    if check:
        try:
            p = subprocess.run(check, shell=True, cwd=cwd, capture_output=True, text=True, timeout=900)
        except subprocess.TimeoutExpired:
            gate_fail(f"Checks timed out: {check}")
        if p.returncode != 0:
            tail = "\n".join((p.stdout + p.stderr).strip().splitlines()[-30:])
            gate_fail(f"Checks failed: {check}\n{tail}")

    risk = os.environ.get("ORCADUCHO_RISK", "low")
    if role != "worker" or risk not in REVIEW_MODEL:
        return
    base = os.environ.get("ORCADUCHO_BASE") or "HEAD~1"
    diff = git("diff", f"{base}...HEAD", cwd=cwd)[:DIFF_LIMIT]  # three dots: only this branch's changes
    if not diff:
        return
    verdict = review(diff, REVIEW_MODEL[risk], f"Orca task {os.environ.get('ORCADUCHO_TASK', '')} (risk: {risk})", cwd)
    if verdict.upper().startswith("FAIL"):
        gate_fail(f"{REVIEW_MODEL[risk]} review failed:\n{verdict[:1500]}")


def review(diff: str, model: str, what: str, cwd: str | None = None) -> str:
    """Run the headless reviewer agent on a diff; returns its PASS/FAIL text ("PASS" if it times out)."""
    prompt = f"Review this diff for {what}. Answer per your instructions.\n\n```diff\n{diff}\n```"
    env = {**os.environ, "ORCADUCHO_ROLE": "reviewer"}
    try:
        lean = lean_args("reviewer", config(cwd))
        p = subprocess.run(["claude", "-p", *plugin_dir_args(bool(lean)), *lean, "--agent", f"{PLUGIN}:reviewer",
                            "--model", model, prompt],
                           cwd=cwd, capture_output=True, text=True, timeout=600, env=env)
    except subprocess.TimeoutExpired:
        return "PASS"  # a stuck reviewer must not block delivery; checks already passed
    return p.stdout.strip()


AUTONOMY = {
    "coordinator": ("Nobody is watching this orcaducho run. Decide yourself: choose the conservative option that "
                    "keeps the plan moving, record the assumption in .orcaducho/plan.md and on the epic issue as "
                    "\"to confirm\", and continue."),
    "lead": "Nobody is watching this orcaducho run. Ask your coordinator with your preamble's `ask` command instead, or decide yourself.",
    "worker": "Nobody is watching this orcaducho run. Ask the coordinator with your preamble's `ask` command instead, or decide yourself.",
}


def autonomous(event: dict) -> bool:
    return bool(config(event.get("cwd")).get("autonomous", True))


def hook_ask(event: dict) -> None:
    """AskUserQuestion would wait for a human forever: answer it with the escalation route instead."""
    role = os.environ.get("ORCADUCHO_ROLE", "")
    if role in AUTONOMY and autonomous(event):
        deny(AUTONOMY[role])


def hook_permission(event: dict) -> None:
    """A permission prompt would stall an unattended session: deny it and say how to proceed."""
    role = os.environ.get("ORCADUCHO_ROLE", "")
    if role not in AUTONOMY or not autonomous(event):
        return
    escalate = ("record it as blocked in .orcaducho/plan.md and continue with the rest" if role == "coordinator"
                else "report it with your preamble's `ask`, or send worker_done --outcome failed if the task cannot be done without it")
    message = (f"No one approves permission prompts in an orcaducho run, so {event.get('tool_name', 'this tool')} was denied. "
               f"Find a way that needs no approval; otherwise {escalate}.")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                             "decision": {"behavior": "deny", "message": message}}}))


CHECKPOINT_RE = re.compile(r"^\s*checkpoint:\s*wave\b.*\n?", re.IGNORECASE | re.MULTILINE)


def plan_file(cwd: str | None) -> Path:
    return toplevel(cwd) / ".orcaducho" / "plan.md"


def run_finished(cwd: str | None) -> bool:
    """done/stopped end the run; awaiting-approval/paused wait for the user (depth plan / epic-approval)."""
    try:
        return bool(re.search(r"^\s*status:\s*(done|stopped|awaiting-approval|paused)\b", plan_file(cwd).read_text(),
                              re.IGNORECASE | re.MULTILINE))
    except OSError:
        return False


def take_checkpoint(cwd: str | None) -> bool:
    """Remove a `Checkpoint: wave` line from plan.md; True if there was one."""
    f = plan_file(cwd)
    try:
        body = f.read_text()
    except OSError:
        return False
    new = CHECKPOINT_RE.sub("", body)
    if new == body:
        return False
    f.write_text(new)
    return True


def detach(cmd: list[str], cwd: str | None) -> None:
    """Run cmd in the background, outliving the hook that started it."""
    subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def hook_stop(event: dict) -> None:
    """Keep the coordinator looping until plan.md says the run is done (Claude Code caps consecutive continuations).

    At a `Checkpoint: wave` it lets the turn end and restarts the conversation instead: /clear plus a resume
    prompt typed into its own Orca terminal, so later waves stop paying for the history of earlier ones.
    """
    if os.environ.get("ORCADUCHO_ROLE") != "coordinator":
        return
    cwd = event.get("cwd")
    handle = os.environ.get("ORCA_TERMINAL_HANDLE")
    if take_checkpoint(cwd) and handle:
        detach([sys.executable, str(Path(__file__).resolve()), "rotate", "--terminal", handle], cwd)
        return
    if not autonomous(event) or run_finished(cwd):
        return
    if event.get("background_tasks"):
        return  # background work will wake the session on its own
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": (
        "The orcaducho run is not finished. Continue the coordinator loop (`orca orchestration check --wait ...`). "
        "When every task has settled and the PR is open, add the line `Status: done` to .orcaducho/plan.md; "
        "if the run cannot continue at all, add `Status: stopped` with one line saying why.")}}))


def cmd_rotate(a: argparse.Namespace) -> None:
    """Restart the coordinator's conversation in place: wait for its turn to end, then /clear and resume."""
    wait = ("terminal", "wait", "--terminal", a.terminal, "--for", "tui-idle", "--timeout-ms", "120000")
    orca(*wait, check=False)
    orca("terminal", "send", "--terminal", a.terminal, "--text", "/clear", "--enter", check=False)
    time.sleep(2)
    orca(*wait, check=False)
    prompt = coordinator_prompt("", config(), int(os.environ.get("ORCADUCHO_DRAIN") or 0))
    orca("terminal", "send", "--terminal", a.terminal, "--text", prompt, "--enter", check=False)


def hook_session(event: dict) -> None:
    """Record every orcaducho session (also after /clear) so `orcaducho cost` can find its transcript."""
    if not event.get("transcript_path"):
        return
    row = {"ts": int(time.time()), "session": event.get("session_id"), "transcript": event["transcript_path"],
           "role": os.environ.get("ORCADUCHO_ROLE"), "model": os.environ.get("ORCADUCHO_MODEL", ""),
           "task": os.environ.get("ORCADUCHO_TASK", ""), "source": event.get("source", "")}
    try:
        with (common_dir(event.get("cwd")) / "sessions.jsonl").open("a") as fh:
            fh.write(json.dumps(row) + "\n")
    except (OSError, SystemExit):
        pass


def hook_post(event: dict) -> None:
    """After worker_done: mirror the summary onto the task's GitHub issue (no model tokens)."""
    issue = os.environ.get("ORCADUCHO_ISSUE")
    command = (event.get("tool_input") or {}).get("command", "")
    if not issue or not issue.isdigit() or not is_worker_done(command) or not shutil.which("gh"):
        return  # "-", or a BACKLOG.md ref: nothing to comment on
    try:
        argv = shlex.split(command)
    except ValueError:
        return
    opts = {argv[i]: argv[i + 1] for i in range(len(argv) - 1) if argv[i].startswith("--")}
    outcome = opts.get("--outcome", "unknown")
    body = render_result(os.environ.get("ORCADUCHO_ROLE", "?"), outcome, opts.get("--subject", ""),
                         opts.get("--body", ""), os.environ.get("ORCADUCHO_MODEL", ""), config(event.get("cwd")))
    subprocess.Popen(["gh", "issue", "comment", issue, "--body", body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if outcome == "failed":
        subprocess.Popen(["gh", "issue", "edit", issue, "--add-label", "status:failed"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_hook(a: argparse.Namespace) -> None:
    role = os.environ.get("ORCADUCHO_ROLE")
    if role not in HOOK_ROLES or (role == "reviewer" and a.which != "session"):
        return  # inert outside orcaducho sessions
    try:
        event = json.load(sys.stdin)
    except json.JSONDecodeError:
        return
    {"guard": hook_guard, "gate": hook_gate, "post": hook_post, "ask": hook_ask,
     "permission": hook_permission, "stop": hook_stop, "session": hook_session}[a.which](event)


# ---------------------------------------------------------------- init

def detect_check(root: Path) -> str:
    """Guess the fast verification command from the project files, so no agent spends tokens on it."""
    pkg = root / "package.json"
    if pkg.exists():
        try:
            scripts = json.loads(pkg.read_text()).get("scripts") or {}
        except (json.JSONDecodeError, AttributeError):
            scripts = {}
        pm = next((m for f, m in (("pnpm-lock.yaml", "pnpm"), ("yarn.lock", "yarn"), ("bun.lockb", "bun"),
                                  ("bun.lock", "bun")) if (root / f).exists()), "npm")
        run_cmd = "npm run" if pm == "npm" else pm
        steps = [s for s in ("typecheck", "lint", "test") if s in scripts]
        return " && ".join(f"{run_cmd} {s}" for s in steps)
    for marker, cmd in (("Cargo.toml", "cargo check && cargo test"), ("go.mod", "go vet ./... && go test ./..."),
                        ("pyproject.toml", "python3 -m pytest -q")):
        if (root / marker).exists():
            return cmd
    return ""


def write_config(root: Path, cfg: dict) -> Path:
    f = root / ".orcaducho.json"
    cfg = {k: v for k, v in cfg.items() if k != "issues"}  # derived from todo
    f.write_text(json.dumps(cfg, indent=2) + "\n")
    exclude = Path(git("rev-parse", "--git-path", "info/exclude", cwd=str(root)))
    exclude = exclude if exclude.is_absolute() else root / exclude
    exclude.parent.mkdir(parents=True, exist_ok=True)
    if ".orcaducho/" not in (exclude.read_text() if exclude.exists() else ""):
        with exclude.open("a") as fh:
            fh.write("\n.orcaducho/\n")
    return f


def detected(root: Path) -> dict:
    """Defaults orcaducho can work out on its own, plus what the project already has for Claude."""
    claude = root / ".claude"

    def size(f: Path) -> int:
        return f.stat().st_size if f.is_file() else 0
    return {
        "check": detect_check(root),
        "base": git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False).removeprefix("origin/"),
        "gh": bool(shutil.which("gh")) and issues_enabled(),
        "config": json.loads((root / ".orcaducho.json").read_text()) if (root / ".orcaducho.json").exists() else None,
        "claudeMdBytes": size(root / "CLAUDE.md") + size(claude / "CLAUDE.md"),
        "skills": sorted(d.parent.name for d in claude.glob("skills/*/SKILL.md")),
        "rules": sorted(f.name for f in claude.glob("rules/*.md")),
        "settings": (claude / "settings.json").exists(),
        "backlog": (root / BACKLOG).exists(),
    }


INIT_FLAGS = ("check", "base", "lang", "advisor", "todo", "depth", "max_items", "ship")


def cmd_init(a: argparse.Namespace) -> None:
    """Set the repo up for orcaducho: an interactive setup agent in a terminal, or flags/--set for scripts."""
    root = toplevel()
    f = root / ".orcaducho.json"
    if a.detect:
        print(json.dumps(detected(root), indent=2))
        return
    if a.set:
        cfg = config()
        cfg.update(parse_setting(item) for item in a.set)
        if cfg.get("depth") == "drain" and cfg.get("todo") == "none":
            die("depth=drain needs a backlog: set todo to issues or markdown")
        print(json.dumps({"config": str(write_config(root, cfg)), **{k: v for k, v in cfg.items() if k != "issues"}}))
        return
    flagged = any(getattr(a, k) is not None for k in INIT_FLAGS) or a.no_issues or a.supervised or \
        a.skip_permissions or a.auto_merge or a.no_isolate
    if not (a.yes or flagged) and sys.stdin.isatty() and sys.stdout.isatty() and shutil.which("claude"):
        prompt = ("Set up this repository for orcaducho and agentic development. orcaducho detected:\n"
                  + json.dumps(detected(root), indent=2))
        argv = ["claude", *plugin_dir_args(), "--agent", f"{PLUGIN}:setup", "--model", "sonnet",
                "-n", f"{PLUGIN}:setup", prompt]
        os.execvp(argv[0], argv)
    if f.exists() and not a.force:
        die(f"{f} already exists (use --force to overwrite, or --set key=value to change one setting)")
    todo = a.todo or ("none" if a.no_issues else "issues")
    cfg = {"check": a.check if a.check is not None else detect_check(root),
           "base": a.base or detected(root)["base"], "todo": todo, "depth": a.depth or "objective",
           "maxItems": a.max_items or 3, "ship": a.ship or "pr-ready", "autoMerge": a.auto_merge,
           "lang": a.lang or "en", "autonomous": not a.supervised, "isolate": not a.no_isolate,
           "advisor": a.advisor or "",
           "claudeArgs": list(SKIP_PERMISSIONS_ARGS if a.skip_permissions else DEFAULT_CLAUDE_ARGS)}
    if cfg["depth"] == "drain" and todo == "none":
        die("--depth drain needs a backlog: use --todo issues or markdown")
    print(json.dumps({"config": str(write_config(root, cfg)), **cfg}))
    if not cfg["check"]:
        print("orcaducho: no check command found; pass --check, or the coordinator fills it in on first run", file=sys.stderr)


# ---------------------------------------------------------------- update

MARKETPLACE_SOURCE = {"source": "github", "repo": "zugazagoitia/orcaducho"}
UPDATE_EVERY_S = 24 * 3600


def claude_dir() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def enable_auto_update() -> bool:
    """Turn on Claude Code's background auto-update for this marketplace (off by default for third parties).

    Uses the documented `extraKnownMarketplaces.<name>.autoUpdate` user setting, which wins over the /plugin toggle.
    """
    f = claude_dir() / "settings.json"
    try:
        settings = json.loads(f.read_text()) if f.exists() else {}
    except (OSError, json.JSONDecodeError):
        return False  # never rewrite a settings file we cannot parse
    entry = settings.setdefault("extraKnownMarketplaces", {}).setdefault(PLUGIN, {"source": MARKETPLACE_SOURCE})
    if entry.get("autoUpdate") is True:
        return True
    entry["autoUpdate"] = True
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(settings, indent=2) + "\n")
    return True


def installed_version() -> str:
    try:
        return json.loads((Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json").read_text())["version"]
    except (OSError, KeyError, json.JSONDecodeError):
        return "?"


def update_now() -> dict:
    """Refresh the marketplace checkout (which the CLI symlink points into) and the installed plugin."""
    before = installed_version()
    ok = True
    for cmd in (["claude", "plugin", "marketplace", "update", PLUGIN], ["claude", "plugin", "update", f"{PLUGIN}@{PLUGIN}"]):
        try:
            ok &= subprocess.run(cmd, capture_output=True, text=True, timeout=120).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
    stamp = claude_dir() / "plugins" / "data" / f"{PLUGIN}-{PLUGIN}" / "last-update-check"
    stamp.parent.mkdir(parents=True, exist_ok=True)
    stamp.write_text(str(int(time.time())))
    return {"ok": ok, "from": before, "to": installed_version()}


def maybe_update() -> None:
    """At most once a day, update before launching a coordinator, so new runs start on the latest release."""
    if os.environ.get("ORCADUCHO_PLUGIN_DIR") or os.environ.get("ORCADUCHO_NO_UPDATE") or not shutil.which("claude"):
        return  # development checkout, opted out, or no CLI to update with
    stamp = claude_dir() / "plugins" / "data" / f"{PLUGIN}-{PLUGIN}" / "last-update-check"
    try:
        if time.time() - int(stamp.read_text()) < UPDATE_EVERY_S:
            return
    except (OSError, ValueError):
        pass
    res = update_now()
    if res["from"] != res["to"]:
        print(f"orcaducho: updated {res['from']} -> {res['to']}", file=sys.stderr)
        os.execvp(sys.executable, [sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]])  # rerun on the new code


def cmd_update(a: argparse.Namespace) -> None:
    auto = enable_auto_update()
    res = {"autoUpdate": auto} if a.auto_only else {"autoUpdate": auto, **update_now()}
    print(json.dumps(res))


# ---------------------------------------------------------------- install

def cmd_install(a: argparse.Namespace) -> None:
    target = Path(a.dir).expanduser()
    target.mkdir(parents=True, exist_ok=True)
    link = target / PLUGIN
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(Path(__file__).resolve())
    print(f"{link} -> {Path(__file__).resolve()}")


# ---------------------------------------------------------------- main

def main() -> None:
    ap = argparse.ArgumentParser(prog=PLUGIN, description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start", help="launch the Opus coordinator")
    s.add_argument("objective", nargs="*")
    s.add_argument("--name", help="create a new top-level worktree/branch with this name for the run")
    s.add_argument("--base", help="base branch for --name (default: config base, else repo default)")
    s.add_argument("--model", default=DEFAULT_MODEL["coordinator"])
    s.add_argument("--effort", default=None)
    s.add_argument("--drain", type=int, default=0, help=argparse.SUPPRESS)  # depth=drain: items done in this chain
    s.add_argument("--item", help="the backlog item (ref from `backlog next`) this run works on")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("spawn", help="start a named, supervised lead/worker for an Orca Task")
    s.add_argument("--role", choices=("lead", "worker"), required=True)
    s.add_argument("--task", required=True)
    s.add_argument("--title", required=True)
    s.add_argument("--model")
    s.add_argument("--effort")
    s.add_argument("--risk", choices=("low", "med", "high"), default="low")
    s.add_argument("--issue")
    s.add_argument("--owns", help="comma-separated globs relative to the repo root")
    s.add_argument("--worktree", default="new-child", help="new-child (default), current, or an Orca selector")
    s.add_argument("--branch")
    s.add_argument("--retry-of")
    s.add_argument("--run")
    s.set_defaults(fn=cmd_spawn)

    s = sub.add_parser("release", help="release a settled worker and close its orcaducho terminal")
    s.add_argument("--dispatch", required=True)
    s.set_defaults(fn=cmd_release)

    s = sub.add_parser("merge", help="merge a child branch into the current branch")
    s.add_argument("branch")
    s.set_defaults(fn=cmd_merge)

    s = sub.add_parser("review", help="review the run branch against its base (exit 3 on FAIL)")
    s.add_argument("--base", help="default: config base")
    s.add_argument("--model", default="sonnet")
    s.set_defaults(fn=cmd_review)

    s = sub.add_parser("issue", help="create an epic or task issue (prints its number, or '-')")
    s.add_argument("kind", choices=("epic", "task"))
    s.add_argument("--title", required=True)
    s.add_argument("--body", help="task: the compact spec (Target/Change/Constraints/Ownership/Acceptance); epic: the plan")
    s.add_argument("--goal", help="epic: one human-readable paragraph; --body then goes in a collapsed block")
    s.add_argument("--parent")
    s.add_argument("--risk", choices=("low", "med", "high"), default="low")
    s.set_defaults(fn=cmd_issue)

    s = sub.add_parser("done", help="mark a task record finished (BACKLOG.md tick, or status:failed on its issue)")
    s.add_argument("ref", help="issue number, BACKLOG.md ref (T3), or -")
    s.add_argument("--failed", action="store_true")
    s.set_defaults(fn=cmd_done)

    s = sub.add_parser("backlog", help="the queue depth=drain works through: next, take <ref>, add <text>")
    s.add_argument("action", choices=("next", "take", "add"))
    s.add_argument("ref", nargs="?", help="take: the ref printed by next; add: the objective text")
    s.set_defaults(fn=cmd_backlog)

    s = sub.add_parser("ship", help="push and open the PR (or keep it local) as the repo's ship policy says")
    s.add_argument("--title", required=True)
    s.add_argument("--body", default="")
    s.set_defaults(fn=cmd_ship)

    s = sub.add_parser("cost", help="token usage of this repo's orcaducho sessions, by role and model")
    s.add_argument("--hours", type=float, help="only sessions started in the last N hours")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_cost)

    s = sub.add_parser("audit", help="report what inflates every session's base context (edits nothing)")
    s.add_argument("--measure", action="store_true", help="also measure a bare call, default vs lean (two Haiku calls)")
    s.set_defaults(fn=cmd_audit)

    s = sub.add_parser("rotate", help="internal: restart the coordinator's conversation at a wave checkpoint")
    s.add_argument("--terminal", required=True)
    s.set_defaults(fn=cmd_rotate)

    s = sub.add_parser("refresh", help="re-render task issues written as raw specs (orcaducho < 0.4)")
    s.add_argument("numbers", nargs="+")
    s.set_defaults(fn=cmd_refresh)

    s = sub.add_parser("hook", help="Claude Code hook entry point")
    s.add_argument("which", choices=("guard", "gate", "post", "ask", "permission", "stop", "session"))
    s.set_defaults(fn=cmd_hook)

    s = sub.add_parser("init", help="set up the current repo: interactive setup agent, or flags/--set for scripts")
    s.add_argument("--check", help="verification command (default: detected from package.json, Cargo.toml, go.mod, pyproject.toml)")
    s.add_argument("--base", help="base branch (default: origin's default branch)")
    s.add_argument("--no-issues", action="store_true", help="do not use GitHub issues")
    s.add_argument("--skip-permissions", action="store_true",
                   help="run agents with --dangerously-skip-permissions instead of auto mode (containers/VMs only)")
    s.add_argument("--lang", choices=("en", "es"), help="language of the issues orcaducho writes (default en)")
    s.add_argument("--todo", choices=SCHEMA["todo"][1], help="where tasks are recorded (default issues)")
    s.add_argument("--depth", choices=SCHEMA["depth"][1], help="how far a run goes (default objective)")
    s.add_argument("--max-items", type=int, help="depth drain: backlog items per chain (default 3)")
    s.add_argument("--ship", choices=SCHEMA["ship"][1], help="how a run is delivered (default pr-ready)")
    s.add_argument("--auto-merge", action="store_true", help="enable auto-merge on the run's PR")
    s.add_argument("--no-isolate", action="store_true", help="give workers your user skills, MCP servers and plugins")
    s.add_argument("--advisor", help="advisor model for leads and workers, e.g. opus (Anthropic API only)")
    s.add_argument("--supervised", action="store_true",
                   help="let agents ask you questions and permission prompts (default: fully autonomous)")
    s.add_argument("--force", action="store_true")
    s.add_argument("--yes", action="store_true", help="write defaults without the interactive setup agent")
    s.add_argument("--set", action="append", metavar="KEY=VALUE", help="change one setting (repeatable)")
    s.add_argument("--detect", action="store_true", help="print detected defaults and the project's Claude setup")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("update", help="update the plugin and CLI now, and turn on background auto-update")
    s.add_argument("--auto-only", action="store_true", help="only turn on auto-update; do not fetch now")
    s.set_defaults(fn=cmd_update)

    s = sub.add_parser("install", help="symlink this CLI onto PATH")
    s.add_argument("--dir", default="~/.local/bin")
    s.set_defaults(fn=cmd_install)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
